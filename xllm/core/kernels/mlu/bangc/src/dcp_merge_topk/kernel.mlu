#include <bang_device_functions_extra.h>
#include <mlu.h>

#include "kernels/mlu/bangc/src/dcp_merge_topk/launch.h"

namespace xllm::kernel::mlu::bangc {
namespace {
constexpr int32_t kCandidates = 8192;
constexpr int32_t kTopk = 2048;
constexpr int32_t kInvalidRank = 0xffc0;

constexpr int32_t kSlotBits = 31;
constexpr int32_t kSlotMask = 0x7fffffff;
constexpr int32_t kPriorityBits = kSlotBits + 16;
// Every valid BF16 rank is at most 0xff80, leaving six low invalid bits.
constexpr int32_t kInvalidBoundaryBit = kSlotBits + 6;
static_assert(kInvalidRank - 0xff80 == (1 << 6));

// Native filtering accepts any nonzero mask bit pattern.
__mlu_func__ void priority_mask(int32_t* dst,
                                const int32_t* src,
                                int32_t n,
                                int32_t bit) {
  __bang_band_scalar(dst, src, 1 << bit, n);
}

// Complements the mask within the current priority bit.
__mlu_func__ void flip_bit_mask(int32_t* mask, int32_t n, int32_t bit) {
  __bang_bxor_scalar(mask, mask, 1 << bit, n);
}

constexpr int32_t kRowStageBytes = 2 * kCandidates * sizeof(int32_t);

// All four shard segments of a query can be issued as one external DMA.
// A padded on-chip pitch retains the logical last-dimension stride for packing.
template <typename T>
__mlu_func__ void load_candidate_row(T* dst,
                                     const T* src,
                                     int64_t shard_stride,
                                     int64_t col_stride,
                                     int32_t* row_stage,
                                     int32_t* small_stage,
                                     const void* bitmask) {
  constexpr int32_t kBytes = sizeof(T);
  const int64_t span = ((kTopk - 1) * col_stride + 1) * kBytes;
  const int64_t pitch = kTopk * col_stride * kBytes;
  const bool shard_dma_fits = shard_stride <= 0x7fffffffLL / kBytes;
  if (col_stride == 1 && shard_dma_fits) {
    __memcpy(dst,
             src,
             kTopk * kBytes,
             GDRAM2NRAM,
             kTopk * kBytes,
             shard_stride * kBytes,
             3);
    return;
  }
  if (pitch <= kRowStageBytes / 4 && shard_dma_fits) {
    __memcpy(row_stage, src, span, GDRAM2NRAM, pitch, shard_stride * kBytes, 3);
    if (col_stride == 2) {
      for (int32_t d = 0; d < 4; ++d) {
        T* block = reinterpret_cast<T*>(reinterpret_cast<char*>(row_stage) +
                                        d * pitch);
        __bang_write_value(block + 2 * kTopk - 1, 1, static_cast<T>(0));
        __bang_filter_bitindex(dst + d * kTopk, block, bitmask, 2 * kTopk);
      }
    } else {
      __memcpy(dst,
               row_stage,
               kBytes,
               NRAM2NRAM,
               kBytes,
               col_stride * kBytes,
               kCandidates - 1);
    }
    return;
  }
  // Very large source shard strides or per-row spans keep a generic path.
  for (int32_t d = 0; d < 4; ++d) {
    const T* source = src + d * shard_stride;
    if (col_stride == 1) {
      __memcpy(dst + d * kTopk, source, kTopk * kBytes, GDRAM2NRAM);
    } else if (span <= kCandidates * sizeof(int32_t)) {
      __memcpy(small_stage, source, span, GDRAM2NRAM);
      if (col_stride == 2) {
        T* block = reinterpret_cast<T*>(small_stage);
        __bang_write_value(block + 2 * kTopk - 1, 1, static_cast<T>(0));
        __bang_filter_bitindex(dst + d * kTopk, block, bitmask, 2 * kTopk);
      } else {
        __memcpy(dst + d * kTopk,
                 small_stage,
                 kBytes,
                 NRAM2NRAM,
                 kBytes,
                 col_stride * kBytes,
                 kTopk - 1);
      }
    } else {
      __memcpy(dst + d * kTopk,
               source,
               kBytes,
               GDRAM2NRAM,
               kBytes,
               col_stride * kBytes,
               kTopk - 1);
    }
  }
}

// Integer normalization in the 16-bit source domain. Descending BF16 rank:
// r = b ^ 0x7fff for sign 0, b for sign 1. NaN or negative slot -> invalid.
// Valid r <= 0xff80 < kInvalidRank, so min(max(r, invalid * kInvalidRank),
// kInvalidRank) selects the canonical invalid rank. Higher priorities win;
// the low word reverses the full nonnegative int32 physical slot range.
__mlu_func__ void prepare_keys(int32_t* keys,
                               int32_t* slots,
                               int32_t* invalid,
                               int32_t* rank,
                               const int16_t* raw,
                               const int32_t* values) {
  __asm__ volatile(
      "fuse.nram.s32.u16 [%[dst]], %[n], [%[src]], .and(%[sign]), "
      ".eq(%[zero]), .mul(%[flip]), .xor([%[src]]);\n\t" ::[dst] "r"(rank),
      [n] "r"(kCandidates),
      [src] "r"(raw),
      [sign] "r"(0x8000),
      [zero] "r"(0),
      [flip] "r"(0x7fff)
      : "memory");
  __asm__ volatile(
      "fuse.nram.s32.u16 [%[dst]], %[n], [%[src]], .and(%[abs]), "
      ".lt(%[limit]), .eq(%[zero]);\n\t" ::[dst] "r"(invalid),
      [n] "r"(kCandidates),
      [src] "r"(raw),
      [abs] "r"(0x7fff),
      [limit] "r"(0x7f81),
      [zero] "r"(0)
      : "memory");
  __asm__ volatile(
      "fuse.nram.s32 [%[dst]], %[n], [%[src]], .lt(%[zero]), "
      ".or([%[nan]]), .mul(%[bad]);\n\t" ::[dst] "r"(invalid),
      [n] "r"(kCandidates),
      [src] "r"(values),
      [zero] "r"(0),
      [nan] "r"(invalid),
      [bad] "r"(kInvalidRank)
      : "memory");
  __asm__ volatile(
      "fuse.nram.s32 [%[dst]], %[n], [%[src]], .max([%[rank]]), "
      ".min(%[bad]), .mul(%[neg]), .add(%[bad]);\n\t" ::[dst] "r"(keys),
      [n] "r"(kCandidates),
      [src] "r"(invalid),
      [rank] "r"(rank),
      [bad] "r"(kInvalidRank),
      [neg] "r"(-1)
      : "memory");
  __asm__ volatile(
      "fuse.nram.s32 [%[dst]], %[n], [%[src]], .max(%[zero]), "
      ".mul(%[neg]), .add(%[max]);\n\t" ::[dst] "r"(slots),
      [n] "r"(kCandidates),
      [src] "r"(values),
      [zero] "r"(0),
      [neg] "r"(-1),
      [max] "r"(kSlotMask)
      : "memory");
}

// Both shard-coalesced input DMAs are asynchronous; consumers __sync_io().
__mlu_func__ void load_dense_row(int16_t* raw,
                                 int32_t* values,
                                 const int16_t* scores,
                                 const int32_t* slots,
                                 int64_t q,
                                 int64_t sq,
                                 int64_t sd,
                                 int64_t vq,
                                 int64_t vd) {
  __memcpy_async(raw,
                 scores + q * sq,
                 kTopk * sizeof(int16_t),
                 GDRAM2NRAM,
                 kTopk * sizeof(int16_t),
                 sd * sizeof(int16_t),
                 3);
  __memcpy_async(values,
                 slots + q * vq,
                 kTopk * sizeof(int32_t),
                 GDRAM2NRAM,
                 kTopk * sizeof(int32_t),
                 vd * sizeof(int32_t),
                 3);
}

__mlu_func__ void swap_words(int32_t*& hi,
                             int32_t*& lo,
                             int32_t*& next_hi,
                             int32_t*& next_lo) {
  int32_t* tmp = hi;
  hi = next_hi;
  next_hi = tmp;
  tmp = lo;
  lo = next_lo;
  next_lo = tmp;
}

__mlu_func__ int32_t bit_width(uint32_t value) {
  int32_t bits = 0;
  while (value != 0) {
    ++bits;
    value >>= 1;
  }
  return bits;
}

// Every input is valid. Constant prefixes are absent from the packed key.
__mlu_func__ int32_t* select_words(int32_t* keys_a,
                                   int32_t* keys_b,
                                   int32_t* mask,
                                   int32_t* selected,
                                   uint32_t varying,
                                   int32_t highest_bit) {
  int32_t* src = keys_a;
  int32_t* dst = keys_b;
  int32_t n = kCandidates;
  int32_t accepted = 0;
  int32_t quota = kTopk;
  int32_t highest_sort_bit = highest_bit;
  for (int32_t bit = highest_bit; bit >= 0 && quota > 0; --bit) {
    if ((varying & (uint32_t{1} << bit)) == 0) {
      continue;
    }
    priority_mask(mask, src, n, bit);
    const int32_t higher = __bang_filter(reinterpret_cast<float*>(dst),
                                         reinterpret_cast<float*>(src),
                                         reinterpret_cast<float*>(mask),
                                         n);
    if (accepted == 0 && (higher == 0 || higher >= quota)) {
      highest_sort_bit = bit - 1;
    }
    if (higher == quota) {
      __bang_add_scalar(selected + accepted, dst, 0, quota);
      quota = 0;
    } else if (higher > quota) {
      if (higher != n) {
        n = higher;
        int32_t* tmp = src;
        src = dst;
        dst = tmp;
      }
    } else if (higher > 0) {
      __bang_add_scalar(selected + accepted, dst, 0, higher);
      accepted += higher;
      quota -= higher;
      flip_bit_mask(mask, n, bit);
      __bang_filter(reinterpret_cast<float*>(dst),
                    reinterpret_cast<float*>(src),
                    reinterpret_cast<float*>(mask),
                    n);
      n -= higher;
      int32_t* tmp = src;
      src = dst;
      dst = tmp;
    }
  }
  if (quota > 0) {
    __bang_add_scalar(selected + accepted, src, 0, quota);
  }
  __bang_add_scalar(keys_a, selected, 0, kTopk);
  src = keys_a;
  dst = keys_b;
  for (int32_t bit = 0; bit <= highest_sort_bit; ++bit) {
    if ((varying & (uint32_t{1} << bit)) == 0) {
      continue;
    }
    priority_mask(mask, src, kTopk, bit);
    const int32_t higher = __bang_filter(reinterpret_cast<float*>(dst),
                                         reinterpret_cast<float*>(src),
                                         reinterpret_cast<float*>(mask),
                                         kTopk);
    if (higher == 0 || higher == kTopk) {
      continue;
    }
    flip_bit_mask(mask, kTopk, bit);
    __bang_filter(reinterpret_cast<float*>(dst + higher),
                  reinterpret_cast<float*>(src),
                  reinterpret_cast<float*>(mask),
                  kTopk);
    int32_t* tmp = src;
    src = dst;
    dst = tmp;
  }
  return src;
}

// MSD selection refines the boundary of the exact (score, physical slot)
// priority. Only the selected TopK pairs enter the final stable LSD sort.
__mlu_func__ int32_t select_pairs(int32_t* hi_a,
                                  int32_t* hi_b,
                                  int32_t* lo_a,
                                  int32_t* lo_b,
                                  int32_t* mask,
                                  int32_t* reduction,
                                  int32_t* selected_hi,
                                  int32_t* selected_lo,
                                  int32_t** sorted_lo) {
  // Inactive destination buffers hold reductions until partitioning starts.
  __bang_bor(mask, hi_a, hi_a + kCandidates / 2, kCandidates / 2);
  __bang_band(reduction, hi_a, hi_a + kCandidates / 2, kCandidates / 2);
  __bang_bor(hi_b, lo_a, lo_a + kCandidates / 2, kCandidates / 2);
  __bang_band(lo_b, lo_a, lo_a + kCandidates / 2, kCandidates / 2);
  for (int32_t span = kCandidates / 4; span > 0; span /= 2) {
    __bang_bor(mask, mask, mask + span, span);
    __bang_band(reduction, reduction, reduction + span, span);
    __bang_bor(hi_b, hi_b, hi_b + span, span);
    __bang_band(lo_b, lo_b, lo_b + span, span);
  }
  __sync_compute();
  const uint32_t varying_hi = static_cast<uint32_t>(mask[0] ^ reduction[0]);
  const uint32_t varying_lo = static_cast<uint32_t>(hi_b[0] ^ lo_b[0]);
  const int32_t common_hi = reduction[0];
  const int32_t common_lo = lo_b[0];
  const int32_t hi_bits = bit_width(varying_hi);
  const int32_t lo_bits = bit_width(varying_lo);
  if (common_hi != 0 && hi_bits + lo_bits <= kSlotBits) {
    const int32_t hi_mask = static_cast<int32_t>((uint32_t{1} << hi_bits) - 1);
    const int32_t lo_mask = static_cast<int32_t>((uint32_t{1} << lo_bits) - 1);
    if (hi_bits == 0) {
      __bang_band_scalar(hi_a, lo_a, lo_mask, kCandidates);
    } else {
      __bang_band_scalar(hi_a, hi_a, hi_mask, kCandidates);
      __bang_mul_scalar(hi_a, hi_a, 1 << lo_bits, kCandidates);
      __bang_band_scalar(lo_a, lo_a, lo_mask, kCandidates);
      __bang_bor(hi_a, hi_a, lo_a, kCandidates);
    }
    int32_t* packed = select_words(hi_a,
                                   hi_b,
                                   mask,
                                   selected_hi,
                                   (varying_hi << lo_bits) | varying_lo,
                                   hi_bits + lo_bits - 1);
    __bang_band_scalar(packed, packed, lo_mask, kTopk);
    __bang_bor_scalar(packed, packed, common_lo & ~lo_mask, kTopk);
    *sorted_lo = packed;
    return kTopk;
  }
  int32_t* src_hi = hi_a;
  int32_t* dst_hi = hi_b;
  int32_t* src_lo = lo_a;
  int32_t* dst_lo = lo_b;
  int32_t n = kCandidates;
  int32_t accepted = 0;
  int32_t quota = kTopk;
  int32_t highest_sort_bit = kPriorityBits - 1;
  bool invalid_prefix = common_hi == 0;
  bool invalid_boundary = false;
  for (int32_t bit = kPriorityBits - 1; bit >= 0 && quota > 0; --bit) {
    const int32_t local_bit = bit >= kSlotBits ? bit - kSlotBits : bit;
    const uint32_t varying = bit >= kSlotBits ? varying_hi : varying_lo;
    if ((varying & (uint32_t{1} << local_bit)) == 0) {
      if (bit == kInvalidBoundaryBit && invalid_prefix) {
        invalid_boundary = true;
        break;
      }
      continue;
    }
    priority_mask(mask, bit >= kSlotBits ? src_hi : src_lo, n, local_bit);
    const int32_t higher = __bang_filter(reinterpret_cast<float*>(dst_hi),
                                         reinterpret_cast<float*>(src_hi),
                                         reinterpret_cast<float*>(mask),
                                         n);
    if (accepted == 0 && (higher == 0 || higher >= quota)) {
      highest_sort_bit = bit - 1;
    }
    if (higher > 0) {
      __bang_filter(reinterpret_cast<float*>(dst_lo),
                    reinterpret_cast<float*>(src_lo),
                    reinterpret_cast<float*>(mask),
                    n);
    }
    if (higher >= quota) {
      if (higher == quota) {
        __bang_add_scalar(selected_hi + accepted, dst_hi, 0, quota);
        __bang_add_scalar(selected_lo + accepted, dst_lo, 0, quota);
        accepted += quota;
        quota = 0;
        break;
      }
      invalid_prefix = false;
      if (higher != n) {
        n = higher;
        swap_words(src_hi, src_lo, dst_hi, dst_lo);
      }
    } else if (higher > 0) {
      __bang_add_scalar(selected_hi + accepted, dst_hi, 0, higher);
      __bang_add_scalar(selected_lo + accepted, dst_lo, 0, higher);
      accepted += higher;
      quota -= higher;
      flip_bit_mask(mask, n, local_bit);
      __bang_filter(reinterpret_cast<float*>(dst_hi),
                    reinterpret_cast<float*>(src_hi),
                    reinterpret_cast<float*>(mask),
                    n);
      __bang_filter(reinterpret_cast<float*>(dst_lo),
                    reinterpret_cast<float*>(src_lo),
                    reinterpret_cast<float*>(mask),
                    n);
      n -= higher;
      swap_words(src_hi, src_lo, dst_hi, dst_lo);
    }
    if (bit == kInvalidBoundaryBit && invalid_prefix) {
      invalid_boundary = true;
      break;
    }
  }
  if (!invalid_boundary && quota > 0) {
    // Identical complete priorities may repeat the same physical slot.
    __bang_add_scalar(selected_hi + accepted, src_hi, 0, quota);
    __bang_add_scalar(selected_lo + accepted, src_lo, 0, quota);
    accepted += quota;
  }
  *sorted_lo = selected_lo;
  if (accepted == 0) {
    return 0;
  }
  // Full-size ping-pong buffers also cover the input-span bounds checked by
  // filtering a compacted tail at an offset.
  __bang_add_scalar(hi_a, selected_hi, 0, accepted);
  __bang_add_scalar(lo_a, selected_lo, 0, accepted);
  src_hi = hi_a;
  dst_hi = hi_b;
  src_lo = lo_a;
  dst_lo = lo_b;
  for (int32_t bit = 0; bit <= highest_sort_bit; ++bit) {
    const int32_t local_bit = bit >= kSlotBits ? bit - kSlotBits : bit;
    const uint32_t varying = bit >= kSlotBits ? varying_hi : varying_lo;
    if ((varying & (uint32_t{1} << local_bit)) == 0) {
      continue;
    }
    priority_mask(
        mask, bit >= kSlotBits ? src_hi : src_lo, accepted, local_bit);
    const int32_t higher = __bang_filter(reinterpret_cast<float*>(dst_hi),
                                         reinterpret_cast<float*>(src_hi),
                                         reinterpret_cast<float*>(mask),
                                         accepted);
    if (higher == 0 || higher == accepted) {
      continue;
    }
    __bang_filter(reinterpret_cast<float*>(dst_lo),
                  reinterpret_cast<float*>(src_lo),
                  reinterpret_cast<float*>(mask),
                  accepted);
    flip_bit_mask(mask, accepted, local_bit);
    __bang_filter(reinterpret_cast<float*>(dst_hi + higher),
                  reinterpret_cast<float*>(src_hi),
                  reinterpret_cast<float*>(mask),
                  accepted);
    __bang_filter(reinterpret_cast<float*>(dst_lo + higher),
                  reinterpret_cast<float*>(src_lo),
                  reinterpret_cast<float*>(mask),
                  accepted);
    swap_words(src_hi, src_lo, dst_hi, dst_lo);
  }
  *sorted_lo = src_lo;
  return accepted;
}

// Neighbouring lengths share a 64-byte line but come from different cores.
// Plain scalar or DMA partial-line stores from many cores at once serialize
// (measured up to ~8us for 32 rows); a memory-side atomic exchange does not.
__mlu_func__ void store_length(int32_t* lengths,
                               int64_t row,
                               int32_t length,
                               int32_t* previous) {
  __bang_atomic_exch(previous, lengths + row, length);
}

// Integer promotion retains every BF16 bit, including signed zero/subnormals.
// Physical slot ordering makes equal-score selection independent of the
// all-gather rank order and local candidate order.
__mlu_global__ void merge_rows(const int16_t* scores,
                               const int32_t* slots,
                               const int32_t* mapping,
                               int32_t* output,
                               int32_t* lengths,
                               int64_t rows,
                               int64_t sd,
                               int64_t sq,
                               int64_t sc,
                               int64_t vd,
                               int64_t vq,
                               int64_t vc,
                               int64_t ms) {
  // Union launches also start the cluster memory cores; all work is IPU work.
  if (__is_mpu()) {
    return;
  }
  __nram__ int16_t raw[kCandidates + kTopk];
  __nram__ int32_t values[kCandidates + kTopk];
  __nram__ int16_t raw_next[kCandidates];
  __nram__ int32_t values_next[kCandidates];
  __nram__ int32_t keys_a[kCandidates];
  __nram__ int32_t keys_b[kCandidates];
  __nram__ int32_t mask[kCandidates];
  __nram__ int32_t scratch[kCandidates];
  __nram__ int32_t selected_hi[kTopk];
  __nram__ int32_t selected_lo[kTopk];
  __nram__ int32_t staged_output[2][kTopk];
  __nram__ int32_t row_stage[2 * kCandidates];
  __nram__ int32_t exchanged[16];
  // 332 KiB plus the compiler's extra buffer; below 512 KiB/IPU.
  // Dense rows are double buffered: row q+taskDim is prefetched on IO while
  // row q computes, and the output store of row q overlaps row
  // q+taskDim. Other strides keep synchronous staging into raw/values.
  const bool dense =
      sc == 1 && vc == 1 && sd <= 0x7fffffffLL / 2 && vd <= 0x7fffffffLL / 4;
  int64_t pending_row = -1;
  int32_t pending_length = 0;
  int32_t* pending_output = staged_output[0];
  int32_t buffer = 0;
  if (dense && taskId < rows) {
    // Issued before the scalar mapping read so both latencies overlap; a
    // padding row simply leaves its loaded inputs unused.
    load_dense_row(raw, values, scores, slots, taskId, sq, sd, vq, vd);
  }
  bool row_valid = taskId < rows && mapping[taskId * ms] >= 0;
  for (int64_t q = taskId; q < rows; q += taskDim, buffer ^= 1) {
    int16_t* row_raw = buffer ? raw_next : raw;
    int32_t* row_values = buffer ? values_next : values;
    int32_t* row_output = staged_output[buffer];
    const int64_t next = q + taskDim;
    const bool next_valid = next < rows && mapping[next * ms] >= 0;
    // Completes this row's prefetch and the store that last used row_output.
    __sync_io();
    if (row_valid && !dense) {
      row_raw = raw;
      row_values = values;
      if (sc == 2 || vc == 2) {
        // Native bitindex filtering selects every even source element.
        // Buffers raw/values reserve the full filter input capacity.
        __bang_write_value(
            reinterpret_cast<uint32_t*>(mask), kCandidates / 16, 0x55555555u);
      }
      load_candidate_row(raw, scores + q * sq, sd, sc, row_stage, keys_b, mask);
      load_candidate_row(
          values, slots + q * vq, vd, vc, row_stage, keys_b, mask);
      // Stride-dependent staging may produce data on IO, Move or Compute.
      __sync();
    }
    if (row_valid) {
      prepare_keys(keys_a, row_stage, mask, keys_b, row_raw, row_values);
    }
    if (pending_row >= 0) {
      // The preceding row completed its staged output before queuing IO.
      __memcpy_async(output + pending_row * kTopk,
                     pending_output,
                     kTopk * sizeof(int32_t),
                     NRAM2GDRAM);
      store_length(lengths, pending_row, pending_length, exchanged);
      pending_row = -1;
    }
    if (dense && next_valid) {
      load_dense_row(buffer ? raw : raw_next,
                     buffer ? values : values_next,
                     scores,
                     slots,
                     next,
                     sq,
                     sd,
                     vq,
                     vd);
    }
    int32_t valid_selected = 0;
    int32_t* sorted_slots = selected_lo;
    if (row_valid) {
      valid_selected = select_pairs(keys_a,
                                    keys_b,
                                    row_stage,
                                    row_stage + kCandidates,
                                    scratch,
                                    mask,
                                    selected_hi,
                                    selected_lo,
                                    &sorted_slots);
    }
    if (valid_selected > 0) {
      __asm__ volatile(
          "fuse.nram.s32 [%[dst]], %[n], [%[src]], .mul(%[neg]), "
          ".add(%[max]);\n\t" ::[dst] "r"(row_output),
          [n] "r"(valid_selected),
          [src] "r"(sorted_slots),
          [neg] "r"(-1),
          [max] "r"(kSlotMask)
          : "memory");
    }
    if (valid_selected < kTopk) {
      __bang_write_value(
          row_output + valid_selected, kTopk - valid_selected, -1);
    }
    // Both the selected slots and invalid tail are complete before IO.
    __sync_compute();
    pending_row = q;
    pending_length = valid_selected;
    pending_output = row_output;
    row_valid = next_valid;
  }
  if (pending_row >= 0) {
    __memcpy_async(output + pending_row * kTopk,
                   pending_output,
                   kTopk * sizeof(int32_t),
                   NRAM2GDRAM);
    store_length(lengths, pending_row, pending_length, exchanged);
  }
  __sync_io();
}
}  // namespace
void launch_dcp_merge_topk(const void* scores,
                           const int32_t* slots,
                           const int32_t* mapping,
                           int32_t* output,
                           int32_t* lengths,
                           int64_t rows,
                           int64_t sd,
                           int64_t sq,
                           int64_t sc,
                           int64_t vd,
                           int64_t vq,
                           int64_t vc,
                           int64_t ms,
                           cnrtQueue_t queue) {
  // A two-cluster union is dispatched as a gang. Block or single-cluster tasks
  // spanning many clusters measured up to ~5us extra dispatch latency after
  // some prior device workloads. Rows beyond Q are skipped by the row loop.
  const int64_t cores = rows < 32 ? (rows + 7) / 8 * 8 : 32;
  cnrtDim3_t dim = {static_cast<uint32_t>(cores), 1, 1};
  merge_rows<<<dim, cnrtFuncTypeUnion2, queue>>>(
      static_cast<const int16_t*>(scores),
      slots,
      mapping,
      output,
      lengths,
      rows,
      sd,
      sq,
      sc,
      vd,
      vq,
      vc,
      ms);
}
}  // namespace xllm::kernel::mlu::bangc
