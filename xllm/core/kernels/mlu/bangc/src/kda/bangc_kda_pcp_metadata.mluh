#pragma once

#include <bang.h>

#include <cstdint>

#include "kernels/mlu/bangc/include/bangc_kda_pcp.h"

// Chunk metadata reads for the KDA PCP prepare, summary and replay kernels.
//
// Scalar loads always come from private NRAM windows, and the GDRAM tables are
// only ever the sources of IO copies. A kernel pointer must never alternate
// between NRAM and GDRAM: the compiler then resolves its loads in one address
// space, so GDRAM metadata was read as NRAM, returning garbage chunk bounds or
// faulting once the address bits exceeded NRAM.
namespace xllm::kernel::mlu::kda_pcp_metadata {

// Rows of chunk_indices and entries of cu_seqlens resident per window. Widths
// are counted in 32-bit words so either int32 or int64 tables fit.
constexpr int32_t kWindowRows = 512;
constexpr int32_t kWindowSequences = 128;
constexpr int32_t kIndexWindowWords = 4 * kWindowRows;
constexpr int32_t kCuWindowWords = 2 * (kWindowSequences + 1);
// Initial window bases that no slot or sequence can hit.
constexpr int64_t kNoWindow = -1;

using AliasUint32 = uint32_t __attribute__((__may_alias__));

__mlu_func__ inline int64_t read_index(const uint32_t* words,
                                       int64_t index,
                                       int32_t kind) {
  if (kind == 0) {
    return static_cast<int32_t>(words[index]);
  }
  const AliasUint32* pairs = reinterpret_cast<const AliasUint32*>(words);
  const uint32_t low = pairs[index * 2];
  const uint32_t high = pairs[index * 2 + 1];
  // PCP token and metadata geometry is bounded by INT32_MAX. Reject a
  // full-word invalid value before deriving any metadata or tensor address.
  if (high != 0 || low > 0x7fffffffU) {
    return -1;
  }
  return static_cast<int64_t>(low);
}

// Loads the window holding entries `first`..`first + span - 1` when it is not
// resident. Window bases are multiples of capacity - span + 1, so adjacent
// windows overlap by span - 1 entries and always hold the whole span. Tables
// up to one window are copied once per task.
__mlu_func__ inline void load_window(uint32_t* window,
                                     int64_t* window_base,
                                     const void* table,
                                     int64_t first,
                                     int64_t span,
                                     int64_t capacity,
                                     int64_t total,
                                     int32_t element_bytes) {
  if (*window_base != kNoWindow && first >= *window_base &&
      first + span <= *window_base + capacity) {
    return;
  }
  const int64_t stride = capacity - span + 1;
  const int64_t base = first / stride * stride;
  const int64_t remaining = total - base;
  const int64_t elements = remaining < capacity ? remaining : capacity;
  __memcpy(window,
           static_cast<const int8_t*>(table) + base * element_bytes,
           elements * element_bytes,
           GDRAM2NRAM);
  // Scalar reads follow the copy; other in-flight IO targets distinct buffers.
  __sync_io();
  *window_base = base;
}

// Returns the row offset of chunk `slot` inside index_window, a private NRAM
// buffer of kIndexWindowWords whose base starts at kNoWindow.
__mlu_func__ inline int64_t index_row(const BangcKdaPcpParams& p,
                                      uint32_t* index_window,
                                      int64_t* index_base,
                                      int64_t slot) {
  const int32_t index_bytes =
      p.indices_kind == 0 ? sizeof(int32_t) : sizeof(int64_t);
  load_window(index_window,
              index_base,
              p.indices,
              /*first=*/slot * 2,
              /*span=*/2,
              /*capacity=*/2 * kWindowRows,
              /*total=*/2 * p.chunks,
              index_bytes);
  return slot * 2 - *index_base;
}

// Returns the first chunk at or after `start` whose recorded sequence equals
// `sequence`, or -1. The entry is not validated. Each resident window is
// scanned in one tight loop, so per-sequence scans over long packed batches
// cost one scalar NRAM load per chunk.
__mlu_func__ inline int64_t find_sequence_chunk(const BangcKdaPcpParams& p,
                                                uint32_t* index_window,
                                                int64_t* index_base,
                                                int64_t sequence,
                                                int64_t start) {
  int64_t slot = start;
  while (slot < p.chunks) {
    int64_t row = index_row(p, index_window, index_base, slot);
    const int64_t remaining = 2 * p.chunks - *index_base;
    const int64_t loaded =
        remaining < 2 * kWindowRows ? remaining : 2 * kWindowRows;
    // First chunk whose two entries are not both resident.
    const int64_t end = (*index_base + loaded) / 2;
    if (p.indices_kind == 0) {
      for (; slot < end; ++slot, row += 2) {
        if (static_cast<int32_t>(index_window[row]) == sequence) {
          return slot;
        }
      }
    } else {
      for (; slot < end; ++slot, row += 2) {
        if (read_index(index_window, row, p.indices_kind) == sequence) {
          return slot;
        }
      }
    }
  }
  return -1;
}

// Resolves chunk `slot` to its sequence, first token and token count.
// cu_window is a private NRAM buffer of kCuWindowWords whose base starts at
// kNoWindow.
__mlu_func__ inline bool locate(const BangcKdaPcpParams& p,
                                uint32_t* index_window,
                                int64_t* index_base,
                                uint32_t* cu_window,
                                int64_t* cu_base,
                                int64_t slot,
                                int64_t* sequence,
                                int64_t* begin,
                                int32_t* count) {
  const int64_t row = index_row(p, index_window, index_base, slot);
  *sequence = read_index(index_window, row, p.indices_kind);
  const int64_t local = read_index(index_window, row + 1, p.indices_kind);
  if (*sequence < 0 || *sequence >= p.sequences || local < 0) {
    return false;
  }
  const int32_t cu_bytes = p.cu_kind == 0 ? sizeof(int32_t) : sizeof(int64_t);
  load_window(cu_window,
              cu_base,
              p.cu,
              /*first=*/*sequence,
              /*span=*/2,
              /*capacity=*/kWindowSequences + 1,
              /*total=*/p.sequences + 1,
              cu_bytes);
  const int64_t entry = *sequence - *cu_base;
  const int64_t first = read_index(cu_window, entry, p.cu_kind);
  const int64_t last = read_index(cu_window, entry + 1, p.cu_kind);
  *begin = first + local * p.block;
  if (first < 0 || last < first || last > p.tokens || *begin < first ||
      *begin > last) {
    return false;
  }
  *count =
      static_cast<int32_t>(last - *begin < p.block ? last - *begin : p.block);
  return true;
}

}  // namespace xllm::kernel::mlu::kda_pcp_metadata
