#include <bang.h>
#include <cnrt.h>
#include <stdint.h>

#include "kernels/mlu/bangc/src/kpool/launchers.h"

namespace {
__mlu_func__ uint32_t positive_position_mod(uint32_t low,
                                            uint32_t high,
                                            uint32_t divisor) {
  uint32_t remainder = high % divisor;
  if (divisor <= 65536) {
    remainder = ((remainder << 16) | (low >> 16)) % divisor;
    return ((remainder << 16) | (low & 65535)) % divisor;
  }
  for (int32_t bit = 31; bit >= 0; --bit) {
    remainder = (remainder * 2 + ((low >> bit) & 1)) % divisor;
  }
  return remainder;
}

// Pack only metadata that needs a dtype change. Each actual element is read
// before its output is stored; callers allocate disjoint contiguous outputs.
__mlu_global__ void pack_integer_metadata_kernel(const int32_t* table_words,
                                                 int32_t* table_output,
                                                 int64_t table_count,
                                                 const int32_t* position_words,
                                                 int32_t* position_output,
                                                 int64_t position_count,
                                                 const int32_t* row_input,
                                                 int32_t* row_words,
                                                 int64_t row_count,
                                                 const int32_t* start_input,
                                                 int32_t* start_words,
                                                 int64_t start_count,
                                                 int32_t position_max,
                                                 int32_t position_mode) {
  constexpr int32_t kTile = 128;
  __nram__ int32_t input[2 * kTile], output[2 * kTile];
  for (int32_t field = 0; field < 4; ++field) {
    int64_t elements = field == 0   ? table_count
                       : field == 1 ? position_count
                       : field == 2 ? row_count
                                    : start_count;
    const int32_t* source = field == 0   ? table_words
                            : field == 1 ? position_words
                            : field == 2 ? row_input
                                         : start_input;
    int32_t* destination = field == 0   ? table_output
                           : field == 1 ? position_output
                           : field == 2 ? row_words
                                        : start_words;
    for (int64_t offset = static_cast<int64_t>(taskId) * kTile;
         offset < elements;
         offset += static_cast<int64_t>(taskDim) * kTile) {
      int32_t count = elements - offset < kTile ? elements - offset : kTile;
      const bool narrowing = field < 2;
      __memcpy(input,
               reinterpret_cast<const char*>(source) +
                   offset * sizeof(int32_t) * (narrowing ? 2 : 1),
               count * sizeof(int32_t) * (narrowing ? 2 : 1),
               GDRAM2NRAM);
      for (int32_t element = 0; element < count; ++element) {
        if (narrowing) {
          int32_t low = input[element * 2], high = input[element * 2 + 1];
          int32_t value = -1;
          if (field == 1 && position_mode == 2 && high >= 0) {
            value = positive_position_mod(static_cast<uint32_t>(low),
                                          static_cast<uint32_t>(high),
                                          static_cast<uint32_t>(position_max));
          } else if (high == 0 && low >= 0) {
            value = low;
            if (field == 1 && value > position_max) {
              value = position_mode == 1 ? position_max : -1;
            }
          } else if (field == 1 && high >= 0 && position_mode == 1) {
            value = position_max;
          }
          output[element] = value;
        } else {
          output[element * 2] = input[element];
          output[element * 2 + 1] = input[element] < 0 ? -1 : 0;
        }
      }
      __sync_compute();
      __memcpy(reinterpret_cast<char*>(destination) +
                   offset * sizeof(int32_t) * (narrowing ? 1 : 2),
               output,
               count * sizeof(int32_t) * (narrowing ? 1 : 2),
               NRAM2GDRAM);
    }
  }
}
}  // namespace

extern "C" void kpool_pack_integer_metadata(void* queue,
                                            const void* table,
                                            void* packed_table,
                                            int64_t table_count,
                                            const void* positions,
                                            void* packed_positions,
                                            int64_t position_count,
                                            const void* rows,
                                            void* packed_rows,
                                            int64_t row_count,
                                            const void* starts,
                                            void* packed_starts,
                                            int64_t start_count,
                                            int32_t position_max,
                                            int32_t clamp_positive_positions) {
  cnrtDim3_t grid = {32, 1, 1};
  pack_integer_metadata_kernel<<<grid,
                                 cnrtFuncTypeBlock,
                                 static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const int32_t*>(table),
      static_cast<int32_t*>(packed_table),
      table_count,
      static_cast<const int32_t*>(positions),
      static_cast<int32_t*>(packed_positions),
      position_count,
      static_cast<const int32_t*>(rows),
      static_cast<int32_t*>(packed_rows),
      row_count,
      static_cast<const int32_t*>(starts),
      static_cast<int32_t*>(packed_starts),
      start_count,
      position_max,
      clamp_positive_positions);
}

namespace {
// GNU may_alias is supported by cncc's Clang frontend. It permits reading the
// stored representation of int64 metadata as two 32-bit words without C++
// strict-aliasing assumptions or the device's narrowing int64 scalar path.
using AliasInt32 = int32_t __attribute__((__may_alias__));

__mlu_func__ int32_t read_row_id(const int64_t* values, int64_t index) {
  const AliasInt32* words = reinterpret_cast<const AliasInt32*>(values);
  int32_t low = words[index * 2];
  int32_t high = words[index * 2 + 1];
  return high == 0 && low >= 0 ? low : -1;
}

// shared_words is populated by a raw byte copy of the int64 row tensor.
// Explicit SRAM scalar loads are supported by both MPU and IPU on mtp592.
__mlu_func__ int32_t read_shared_row_id(const int32_t* shared_words,
                                        int32_t index) {
  int32_t low = __load_sram(shared_words + index * 2);
  int32_t high = __load_sram(shared_words + index * 2 + 1);
  return high == 0 && low >= 0 ? low : -1;
}

template <typename Id>
__mlu_func__ int32_t read_state_id(const Id* values, int64_t index) {
  if constexpr (sizeof(Id) == sizeof(int64_t)) {
    int32_t value =
        read_row_id(reinterpret_cast<const int64_t*>(values), index);
    return value > 0 ? value : 0;
  } else {
    int32_t value = values[index];
    return value > 0 ? value : 0;
  }
}

__mlu_func__ void pool_one(const bfloat16_t* key,
                           const bfloat16_t* gate,
                           const float* ape,
                           const float* matrix,
                           const bfloat16_t* tail,
                           int64_t endpoint,
                           int64_t start,
                           int64_t pos,
                           int64_t state,
                           const int32_t* positions,
                           int32_t ring_size,
                           bfloat16_t* result,
                           const bfloat16_t* last_key,
                           const bfloat16_t* last_gate,
                           bool local_tail,
                           bool local_matrix,
                           bool local_bias = false,
                           bool prefill_mode = false,
                           bool local_four = false) {
  __nram__ bfloat16_t raw[4 * 128], gates[4 * 128], rounded[128];
  __nram__ int32_t member_positions[4];
  __nram__ float keys[4 * 128], logits[4 * 128], bias[4 * 128];
  __nram__ float maximum[128], denominator[128], pooled[128], h[128 * 128],
      product[128 * 128], output[128];
  if (!local_bias) {
    __memcpy_async(bias, ape, sizeof(bias), GDRAM2NRAM);
  }
  if (local_four) {
    __memcpy(raw, key, sizeof(raw), NRAM2NRAM);
    __memcpy(gates, gate, sizeof(gates), NRAM2NRAM);
  } else {
    int64_t first_source = endpoint - 3 > start ? endpoint - 3 : start;
    int32_t first_slot = first_source - endpoint + 3;
    if (first_slot < 3) {
      __memcpy(member_positions + first_slot,
               positions + first_source,
               (3 - first_slot) * 4,
               GDRAM2NRAM);
    }
    for (int32_t slot = 0; slot < 4; ++slot) {
      int64_t source = endpoint - 3 + slot;
      bool current =
          slot == 3 || (source >= start && member_positions[slot] >= 0);
      int64_t ring = (pos - 3 + slot) % ring_size;
      const bfloat16_t* kp =
          current
              ? key + source * 128
              : tail + ((local_tail ? 0 : state * 2 * ring_size) + ring) * 128;
      const bfloat16_t* gp =
          current ? gate + source * 128
                  : tail + ((local_tail ? 0 : state * 2 * ring_size) +
                            ring_size + ring) *
                               128;
      if (slot == 3) {
        __memcpy(raw + slot * 128, last_key, 256, NRAM2NRAM);
        __memcpy(gates + slot * 128, last_gate, 256, NRAM2NRAM);
      } else {
        if (!current && local_tail) {
          __memcpy_async(raw + slot * 128, kp, 256, NRAM2NRAM);
          __memcpy_async(gates + slot * 128, gp, 256, NRAM2NRAM);
        } else {
          __memcpy_async(raw + slot * 128, kp, 256, GDRAM2NRAM);
          __memcpy_async(gates + slot * 128, gp, 256, GDRAM2NRAM);
        }
      }
    }
  }
  __sync_io();
  __sync_move();
  if (!local_matrix) {
    __memcpy_async(h, matrix, 128 * 512, GDRAM2NRAM);
  }
  __bang_bfloat162float(keys, raw, 512);
  __bang_bfloat162float(logits, gates, 512);
  __bang_add(logits, logits, local_bias ? ape : bias, 512);
  __bang_maxpool(maximum, logits, 128, 1, 4, 1, 4, 1, 1);
  __bang_cycle_sub(logits, logits, maximum, 512, 128);
  __bang_mul_scalar(logits, logits, 1.4426950408889634f, 512);
  __bang_pow2(logits, logits, 512);
  if (prefill_mode) {
    __bang_sumpool(denominator, logits, 128, 1, 4, 1, 4, 1, 1);
  } else {
    __bang_add(denominator, logits, logits + 128, 128);
    __bang_add(denominator, denominator, logits + 256, 128);
    __bang_add(denominator, denominator, logits + 384, 128);
  }
  if (prefill_mode) {
    __sync_compute();
    __memcpy(bias, denominator, 512, NRAM2NRAM, 512, 0, 3);
    __bang_div(logits, logits, bias, 512);
    __bang_mul(keys, keys, logits, 512);
    __bang_sumpool(pooled, keys, 128, 1, 4, 1, 4, 1, 1);
  } else {
    __bang_mul(keys, keys, logits, 512);
    __bang_add(pooled, keys, keys + 128, 128);
    __bang_add(pooled, pooled, keys + 256, 128);
    __bang_add(pooled, pooled, keys + 384, 128);
    __bang_div(pooled, pooled, denominator, 128);
  }
  __bang_float2bfloat16_rn(rounded, pooled, 128);
  __bang_bfloat162float(pooled, rounded, 128);
  __sync_io();
  __bang_cycle_mul(h, local_matrix ? matrix : h, pooled, 128 * 128, 128);
  __bang_transpose(product, h, 128, 128);
  __bang_sumpool(output, product, 128, 1, 128, 1, 128, 1, 1);
  __bang_float2bfloat16_rn(result, output, 128);
}

// A nonnegative int64 position is consumed as stored words: scalar narrowing
// on this compiler does not preserve every int64 metadata sentinel.
__mlu_func__ bool valid_wide_position(const int64_t* positions, int64_t token) {
  const AliasInt32* words = reinterpret_cast<const AliasInt32*>(positions);
  return words[token * 2 + 1] >= 0;
}

template <typename Id>
__mlu_global__ void snapshot_wide_update_sources_kernel(const bfloat16_t* tail,
                                                        const Id* ids,
                                                        const Id* read_ids,
                                                        bfloat16_t* workspace,
                                                        int32_t batch,
                                                        int32_t ring_size,
                                                        bool inherit) {
  constexpr int32_t kElements = 16384;
  __nram__ bfloat16_t chunk[kElements];
  const int64_t elements = static_cast<int64_t>(ring_size) * 2 * 128;
  for (int64_t request = taskId; request < batch; request += taskDim) {
    int32_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    int32_t source = inherit ? read_state_id(read_ids, request) : state;
    for (int64_t offset = 0; offset < elements; offset += kElements) {
      int32_t count =
          elements - offset < kElements ? elements - offset : kElements;
      if (source > 0) {
        __memcpy(chunk,
                 tail + static_cast<int64_t>(source) * elements + offset,
                 count * sizeof(bfloat16_t),
                 GDRAM2NRAM);
      } else {
        __bang_write_value(chunk, count, static_cast<bfloat16_t>(0));
        __sync_compute();
      }
      __memcpy(workspace + request * elements + offset,
               chunk,
               count * sizeof(bfloat16_t),
               NRAM2GDRAM);
    }
  }
}

// Decode owns one destination per request and advances it chronologically.
// Prefill reads the immutable initial source and writes cache only; the safe
// stash launch follows after every pool reader has completed.
template <typename Id, bool Prefill>
__mlu_global__ void wide_position_pool_kernel(const bfloat16_t* key,
                                              const bfloat16_t* gate,
                                              const float* ape,
                                              const float* matrix,
                                              bfloat16_t* cache,
                                              bfloat16_t* tail,
                                              const Id* ids,
                                              const Id* read_ids,
                                              const int32_t* table,
                                              const int64_t* positions,
                                              const int64_t* starts,
                                              const int64_t* rows,
                                              const bfloat16_t* workspace,
                                              int32_t batch,
                                              int32_t tokens,
                                              int32_t table_width,
                                              int32_t ring_size) {
  __nram__ bfloat16_t four_keys[512], four_gates[512], result[128];
  __nram__ bfloat16_t copy_chunk[16384];
  __nram__ float local_matrix[128 * 128], local_bias[512];
  bool coefficients_ready = false;
  const AliasInt32* words = reinterpret_cast<const AliasInt32*>(positions);
  const int64_t ring_elements = static_cast<int64_t>(ring_size) * 2 * 128;
  int64_t jobs = Prefill ? tokens : batch;
  for (int64_t job = taskId; job < jobs; job += taskDim) {
    int32_t request = Prefill ? read_row_id(rows, job) : job;
    if (request < 0 || request >= batch) {
      continue;
    }
    int32_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    int32_t source_state = Prefill ? read_state_id(read_ids, request) : state;
    if constexpr (!Prefill) {
      for (int64_t offset = 0; offset < ring_elements; offset += 16384) {
        int32_t count =
            ring_elements - offset < 16384 ? ring_elements - offset : 16384;
        __memcpy(
            copy_chunk,
            workspace + static_cast<int64_t>(request) * ring_elements + offset,
            count * sizeof(bfloat16_t),
            GDRAM2NRAM);
        __memcpy(tail + static_cast<int64_t>(state) * ring_elements + offset,
                 copy_chunk,
                 count * sizeof(bfloat16_t),
                 NRAM2GDRAM);
      }
    }
    int64_t begin = starts[request];
    int64_t first = Prefill ? job : begin;
    int64_t end = Prefill ? job + 1 : starts[request + 1];
    for (int64_t token = first; token < end; ++token) {
      int32_t high = words[token * 2 + 1];
      if (high < 0) {
        continue;
      }
      uint32_t low = static_cast<uint32_t>(words[token * 2]);
      int32_t ring = positive_position_mod(
          low, static_cast<uint32_t>(high), static_cast<uint32_t>(ring_size));
      bool endpoint = (low & 3) == 3;
      bool cache_position = high == 0 && low / 16 < table_width;
      int32_t block =
          endpoint && cache_position
              ? table[static_cast<int64_t>(request) * table_width + low / 16]
              : -1;
      if (block >= 0) {
        for (int32_t member = 0; member < 4; ++member) {
          int64_t source = token - 3 + member;
          bool current =
              source >= begin && valid_wide_position(positions, source);
          bfloat16_t* key_output = four_keys + member * 128;
          bfloat16_t* gate_output = four_gates + member * 128;
          if (current) {
            __memcpy_async(key_output, key + source * 128, 256, GDRAM2NRAM);
            __memcpy_async(gate_output, gate + source * 128, 256, GDRAM2NRAM);
          } else if (source_state > 0) {
            int32_t member_ring =
                (static_cast<int64_t>(ring) + ring_size - 3 + member) %
                ring_size;
            const bfloat16_t* history =
                tail + static_cast<int64_t>(source_state) * ring_elements;
            __memcpy_async(
                key_output, history + member_ring * 128, 256, GDRAM2NRAM);
            __memcpy_async(
                gate_output,
                history + (static_cast<int64_t>(ring_size) + member_ring) * 128,
                256,
                GDRAM2NRAM);
          } else {
            __bang_write_value(key_output, 128, static_cast<bfloat16_t>(0));
            __bang_write_value(gate_output, 128, static_cast<bfloat16_t>(0));
          }
        }
        if (!coefficients_ready) {
          __memcpy_async(
              local_matrix, matrix, sizeof(local_matrix), GDRAM2NRAM);
          __memcpy_async(local_bias, ape, sizeof(local_bias), GDRAM2NRAM);
        }
        __sync();
        coefficients_ready = true;
        pool_one(four_keys,
                 four_gates,
                 local_bias,
                 local_matrix,
                 tail,
                 3,
                 0,
                 3,
                 state,
                 nullptr,
                 ring_size,
                 result,
                 four_keys + 384,
                 four_gates + 384,
                 false,
                 true,
                 true,
                 Prefill,
                 true);
        __sync_compute();
        __memcpy(
            cache + (static_cast<int64_t>(block) * 4 + (low / 4) % 4) * 128,
            result,
            256,
            NRAM2GDRAM);
      }
      if constexpr (!Prefill) {
        // Cache capacity and missing pages do not suppress tail recurrence.
        __memcpy_async(four_keys, key + token * 128, 256, GDRAM2NRAM);
        __memcpy_async(four_gates, gate + token * 128, 256, GDRAM2NRAM);
        __sync_io();
        __memcpy_async(tail + static_cast<int64_t>(state) * ring_elements +
                           static_cast<int64_t>(ring) * 128,
                       four_keys,
                       256,
                       NRAM2GDRAM);
        __memcpy_async(tail + static_cast<int64_t>(state) * ring_elements +
                           (static_cast<int64_t>(ring_size) + ring) * 128,
                       four_gates,
                       256,
                       NRAM2GDRAM);
        __sync_io();
      }
    }
  }
}

template <typename Id>
void launch_wide_position_update(void* queue,
                                 const void* key,
                                 const void* gate,
                                 const void* ape,
                                 const void* matrix,
                                 void* cache,
                                 void* tail,
                                 const void* ids,
                                 const void* read_ids,
                                 const void* table,
                                 const void* positions,
                                 const void* starts,
                                 const void* rows,
                                 void* workspace,
                                 int32_t batch,
                                 int32_t tokens,
                                 int32_t table_width,
                                 int32_t ring_size,
                                 int32_t inherit,
                                 int32_t prefill) {
  cnrtDim3_t grid = {32, 1, 1};
  cnrtQueue_t stream = static_cast<cnrtQueue_t>(queue);
  if (prefill == 0) {
    snapshot_wide_update_sources_kernel<<<grid, cnrtFuncTypeBlock, stream>>>(
        static_cast<const bfloat16_t*>(tail),
        static_cast<const Id*>(ids),
        static_cast<const Id*>(read_ids),
        static_cast<bfloat16_t*>(workspace),
        batch,
        ring_size,
        inherit != 0);
  }
  if (prefill != 0) {
    wide_position_pool_kernel<Id, true><<<grid, cnrtFuncTypeBlock, stream>>>(
        static_cast<const bfloat16_t*>(key),
        static_cast<const bfloat16_t*>(gate),
        static_cast<const float*>(ape),
        static_cast<const float*>(matrix),
        static_cast<bfloat16_t*>(cache),
        static_cast<bfloat16_t*>(tail),
        static_cast<const Id*>(ids),
        static_cast<const Id*>(read_ids),
        static_cast<const int32_t*>(table),
        static_cast<const int64_t*>(positions),
        static_cast<const int64_t*>(starts),
        static_cast<const int64_t*>(rows),
        nullptr,
        batch,
        tokens,
        table_width,
        ring_size);
  } else {
    wide_position_pool_kernel<Id, false><<<grid, cnrtFuncTypeBlock, stream>>>(
        static_cast<const bfloat16_t*>(key),
        static_cast<const bfloat16_t*>(gate),
        static_cast<const float*>(ape),
        static_cast<const float*>(matrix),
        static_cast<bfloat16_t*>(cache),
        static_cast<bfloat16_t*>(tail),
        static_cast<const Id*>(ids),
        static_cast<const Id*>(read_ids),
        static_cast<const int32_t*>(table),
        static_cast<const int64_t*>(positions),
        static_cast<const int64_t*>(starts),
        nullptr,
        static_cast<const bfloat16_t*>(workspace),
        batch,
        tokens,
        table_width,
        ring_size);
  }
}

template <typename Id,
          bool Cooperative = false,
          bool Snapshot = false,
          int32_t LocalSlots = 64,
          bool CacheCoefficients = false>
__mlu_global__ void update_kernel(const bfloat16_t* key,
                                  const bfloat16_t* gate,
                                  const float* ape,
                                  const float* matrix,
                                  bfloat16_t* cache,
                                  bfloat16_t* tail,
                                  const Id* ids,
                                  const Id* read_ids,
                                  const int32_t* table,
                                  const int32_t* positions,
                                  const int64_t* starts,
                                  int32_t batch,
                                  int32_t table_width,
                                  int32_t ring_size,
                                  bool inherit,
                                  const bfloat16_t* snapshot = nullptr) {
  __nram__ bfloat16_t out[128], kv[128], gv[128];
  __nram__ bfloat16_t inherited_storage[2 * LocalSlots * 128];
  bfloat16_t* inherited = inherited_storage;
  __nram__ bfloat16_t four_keys[512], four_gates[512];
  __nram__ int32_t four_positions[4];
  __nram__ float cached_matrix[CacheCoefficients ? 128 * 128 : 1];
  __nram__ float cached_bias[CacheCoefficients ? 4 * 128 : 1];
  // NRAM is not initialized between launches. Only a completed load in this
  // invocation makes these read-only coefficients available for reuse.
  bool coefficients_ready = false;
  if constexpr (Cooperative) {
    if (__is_mpu()) {
      return;
    }
    // Every source owned by this IPU is staged before the global barrier.
    // ceil(batch / taskDim) * ring_size <= LocalSlots is checked at launch;
    // each request therefore owns a disjoint contiguous NRAM ring.
    for (int64_t request = taskId; request < batch; request += taskDim) {
      if (read_state_id(ids, request) <= 0) {
        continue;
      }
      bfloat16_t* staged =
          inherited_storage + (request / taskDim) * 2 * ring_size * 128;
      int64_t source_state = read_state_id(read_ids, request);
      if (source_state > 0) {
        __memcpy(staged,
                 tail + source_state * 2 * ring_size * 128,
                 2 * ring_size * 256,
                 GDRAM2NRAM);
      } else {
        __bang_write_value(
            staged, 2 * ring_size * 128, static_cast<bfloat16_t>(0));
      }
    }
    __sync();
    if (taskDim > 1) {
      __sync_all_ipu();
    }
  }
  for (int64_t req = taskId; req < batch; req += taskDim) {
    if constexpr (Cooperative) {
      inherited = inherited_storage + (req / taskDim) * 2 * ring_size * 128;
    }
    int64_t state = read_state_id(ids, req);
    if (state <= 0) {
      continue;
    }
    bool local_tail = inherit && ring_size <= 64;
    bool direct_tail = local_tail && ring_size >= 4;
    int64_t source_state = inherit ? read_state_id(read_ids, req) : state;
    if (local_tail && !Cooperative) {
      if constexpr (Snapshot) {
        __memcpy(inherited,
                 snapshot + req * 2 * ring_size * 128,
                 2 * ring_size * 256,
                 GDRAM2NRAM);
      } else if (source_state > 0) {
        __memcpy(inherited,
                 tail + source_state * 2 * ring_size * 128,
                 2 * ring_size * 256,
                 GDRAM2NRAM);
      } else {
        __bang_write_value(
            inherited, 2 * ring_size * 128, static_cast<bfloat16_t>(0));
        if (direct_tail) {
          __sync_compute();
        }
      }
    } else if (!local_tail && source_state != state) {
      for (int32_t r = 0; r < 2 * ring_size; ++r) {
        if (source_state > 0) {
          __memcpy(kv,
                   tail + (source_state * 2 * ring_size + r) * 128,
                   256,
                   GDRAM2NRAM);
        } else {
          __bang_write_value(kv, 128, static_cast<bfloat16_t>(0));
        }
        __memcpy(tail + (state * 2 * ring_size + r) * 128, kv, 256, NRAM2GDRAM);
      }
    }
    int64_t begin = starts[req], end = starts[req + 1];
    bool reuse_coefficients =
        CacheCoefficients && (batch > taskDim || end - begin > 4);
    for (int64_t i = begin; i < end; ++i) {
      int64_t pos = positions[i];
      if (pos < 0) {
        continue;
      }
      if (direct_tail && end - i >= 4 && pos % 4 == 0) {
        __memcpy(
            four_positions, positions + i, sizeof(four_positions), GDRAM2NRAM);
        int32_t first = four_positions[0], last = four_positions[3];
        bool whole_pool = first >= 0 && last % 4 == 3 &&
                          four_positions[1] == first + 1 &&
                          four_positions[2] == first + 2 && last == first + 3;
        if (whole_pool) {
          __memcpy_async(
              four_keys, key + i * 128, sizeof(four_keys), GDRAM2NRAM);
          __memcpy_async(
              four_gates, gate + i * 128, sizeof(four_gates), GDRAM2NRAM);
          __sync_io();
          int32_t block = last / 16 < table_width
                              ? table[req * table_width + last / 16]
                              : -1;
          if (block >= 0) {
            if (reuse_coefficients && !coefficients_ready) {
              __memcpy_async(
                  cached_matrix, matrix, sizeof(cached_matrix), GDRAM2NRAM);
              __memcpy_async(cached_bias, ape, sizeof(cached_bias), GDRAM2NRAM);
              __sync_io();
              coefficients_ready = true;
            }
            pool_one(four_keys,
                     four_gates,
                     reuse_coefficients ? cached_bias : ape,
                     reuse_coefficients ? cached_matrix : matrix,
                     inherited,
                     3,
                     0,
                     last,
                     state,
                     four_positions,
                     ring_size,
                     out,
                     four_keys + 384,
                     four_gates + 384,
                     true,
                     reuse_coefficients,
                     reuse_coefficients,
                     false,
                     true);
            __memcpy(
                cache + (block * 4 + last / 4 % 4) * 128, out, 256, NRAM2GDRAM);
          }
          int32_t slot = first % ring_size;
          int32_t first_count = ring_size - slot < 4 ? ring_size - slot : 4;
          __memcpy(
              inherited + slot * 128, four_keys, first_count * 256, NRAM2NRAM);
          __memcpy(inherited + (ring_size + slot) * 128,
                   four_gates,
                   first_count * 256,
                   NRAM2NRAM);
          if (first_count < 4) {
            __memcpy(inherited,
                     four_keys + first_count * 128,
                     (4 - first_count) * 256,
                     NRAM2NRAM);
            __memcpy(inherited + ring_size * 128,
                     four_gates + first_count * 128,
                     (4 - first_count) * 256,
                     NRAM2NRAM);
          }
          __sync_compute();
          i += 3;
          continue;
        }
      }
      bfloat16_t* token_key =
          direct_tail ? inherited + pos % ring_size * 128 : kv;
      bfloat16_t* token_gate =
          direct_tail ? inherited + (ring_size + pos % ring_size) * 128 : gv;
      __memcpy_async(token_key, key + i * 128, 256, GDRAM2NRAM);
      __memcpy_async(token_gate, gate + i * 128, 256, GDRAM2NRAM);
      __sync_io();
      if (pos % 4 == 3) {
        if (reuse_coefficients && !coefficients_ready) {
          __memcpy_async(
              cached_matrix, matrix, sizeof(cached_matrix), GDRAM2NRAM);
          __memcpy_async(cached_bias, ape, sizeof(cached_bias), GDRAM2NRAM);
          __sync_io();
          coefficients_ready = true;
        }
        pool_one(key,
                 gate,
                 reuse_coefficients ? cached_bias : ape,
                 reuse_coefficients ? cached_matrix : matrix,
                 local_tail ? inherited : tail,
                 i,
                 starts[req],
                 pos,
                 state,
                 positions,
                 ring_size,
                 out,
                 token_key,
                 token_gate,
                 local_tail,
                 reuse_coefficients,
                 reuse_coefficients);
        int32_t block =
            pos / 16 < table_width ? table[req * table_width + pos / 16] : -1;
        if (block >= 0) {
          __memcpy(
              cache + (block * 4 + pos / 4 % 4) * 128, out, 256, NRAM2GDRAM);
        }
      }

      if (local_tail && !direct_tail) {
        __memcpy(inherited + pos % ring_size * 128, kv, 256, NRAM2NRAM);
        __memcpy(inherited + (ring_size + pos % ring_size) * 128,
                 gv,
                 256,
                 NRAM2NRAM);
      } else if (!local_tail) {
        __memcpy_async(tail + (state * 2 * ring_size + pos % ring_size) * 128,
                       kv,
                       256,
                       NRAM2GDRAM);
        __memcpy_async(
            tail + (state * 2 * ring_size + ring_size + pos % ring_size) * 128,
            gv,
            256,
            NRAM2GDRAM);
        __sync_io();
      }
      // Direct tail loads have no Compute reader between pooling endpoints.
      // A completed pool may read a slot reused by the next token, including
      // when its cache page is missing, so close that lifetime explicitly.
      if (!direct_tail || pos % 4 == 3) {
        __sync_compute();
      }
    }
    if (local_tail) {
      __memcpy(tail + state * 2 * ring_size * 128,
               inherited,
               2 * ring_size * 256,
               NRAM2GDRAM);
    }
  }
}
}  // namespace
extern "C" void kpool_update(void* queue,
                             const void* key,
                             const void* gate,
                             const void* ape,
                             const void* matrix,
                             void* cache,
                             void* tail,
                             const void* ids,
                             const void* read_ids,
                             const void* table,
                             const void* positions,
                             const void* starts,
                             int32_t batch,
                             int32_t table_width,
                             int32_t ring_size,
                             int32_t inherit) {
  cnrtDim3_t grid = {static_cast<uint32_t>(batch < 32 ? batch : 32), 1, 1};
  update_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const float*>(ape),
      static_cast<const float*>(matrix),
      static_cast<bfloat16_t*>(cache),
      static_cast<bfloat16_t*>(tail),
      static_cast<const int64_t*>(ids),
      static_cast<const int64_t*>(read_ids),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      batch,
      table_width,
      ring_size,
      inherit != 0);
}

extern "C" void kpool_update_i32(void* queue,
                                 const void* key,
                                 const void* gate,
                                 const void* ape,
                                 const void* matrix,
                                 void* cache,
                                 void* tail,
                                 const void* ids,
                                 const void* read_ids,
                                 const void* table,
                                 const void* positions,
                                 const void* starts,
                                 int32_t batch,
                                 int32_t table_width,
                                 int32_t ring_size,
                                 int32_t inherit) {
  cnrtDim3_t grid = {static_cast<uint32_t>(batch < 32 ? batch : 32), 1, 1};
  update_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const float*>(ape),
      static_cast<const float*>(matrix),
      static_cast<bfloat16_t*>(cache),
      static_cast<bfloat16_t*>(tail),
      static_cast<const int32_t*>(ids),
      static_cast<const int32_t*>(read_ids),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      batch,
      table_width,
      ring_size,
      inherit != 0);
}

namespace {
template <typename Id>
__mlu_global__ void prefill_kernel(const bfloat16_t* key,
                                   const bfloat16_t* gate,
                                   const float* ape,
                                   const float* matrix,
                                   bfloat16_t* cache,
                                   const bfloat16_t* tail,
                                   const Id* read_ids,
                                   const int32_t* table,
                                   const int32_t* positions,
                                   const int64_t* starts,
                                   const int64_t* rows,
                                   int32_t tokens,
                                   int32_t table_width,
                                   int32_t ring_size,
                                   int32_t batch,
                                   const Id* destination_ids) {
  __nram__ bfloat16_t out[128], kv[128], gv[128];
  __nram__ bfloat16_t four_keys[512], four_gates[512];
  __nram__ int32_t member_positions[3];
  __nram__ int32_t position_tile[128];
  __nram__ int64_t row_tile[128];
  __nram__ float matrix_tile[128 * 128], bias_tile[512];
  bool cache_bias = tokens > taskDim * 4;
  if (cache_bias) {
    __memcpy(bias_tile, ape, sizeof(bias_tile), GDRAM2NRAM);
  }
  bool cache_matrix = tokens > taskDim * 4;
  if (cache_matrix) {
    __memcpy(matrix_tile, matrix, sizeof(matrix_tile), GDRAM2NRAM);
  }
  bool regular = tokens % (taskDim * 4) == 0;
  int32_t chunk = tokens / taskDim + (tokens % taskDim != 0);
  int32_t end = regular ? (taskId + 1) * chunk : tokens;
  int32_t step = regular ? 1 : taskDim;
  for (int32_t first = regular ? taskId * chunk : taskId; first < end;
       first += step * 128) {
    int32_t count = (end - first + step - 1) / step;
    count = count < 128 ? count : 128;
    if (step == 1) {
      __memcpy_async(position_tile, positions + first, count * 4, GDRAM2NRAM);
      __memcpy_async(row_tile, rows + first, count * 8, GDRAM2NRAM);
    } else {
      __memcpy_async(position_tile,
                     positions + first,
                     4,
                     GDRAM2NRAM,
                     4,
                     step * 4,
                     count - 1);
      __memcpy_async(
          row_tile, rows + first, 8, GDRAM2NRAM, 8, step * 8, count - 1);
    }
    __sync_io();
    for (int32_t local = 0; local < count; ++local) {
      int32_t i = first + local * step;
      int32_t pos = position_tile[local];
      if (pos < 0 || pos % 4 != 3 || pos / 16 >= table_width) {
        continue;
      }
      const AliasInt32* row_words =
          reinterpret_cast<const AliasInt32*>(row_tile);
      int32_t req = row_words[local * 2];
      if (row_words[local * 2 + 1] != 0 || req < 0 || req >= batch) {
        continue;
      }
      if (read_state_id(destination_ids, req) <= 0) {
        continue;
      }
      int64_t state = read_state_id(read_ids, req);
      int64_t request_start = starts[req];
      bool all_current = i - 3 >= request_start;
      if (all_current) {
        if (step == 1 && local >= 3) {
          for (int32_t member = 0; member < 3; ++member) {
            if (position_tile[local - 3 + member] < 0) {
              all_current = false;
            }
          }
        } else {
          __memcpy(member_positions,
                   positions + i - 3,
                   sizeof(member_positions),
                   GDRAM2NRAM);
          for (int32_t member = 0; member < 3; ++member) {
            if (member_positions[member] < 0) {
              all_current = false;
            }
          }
        }
      }
      if (all_current || state <= 0) {
        if (all_current) {
          __memcpy_async(
              four_keys, key + (i - 3) * 128, sizeof(four_keys), GDRAM2NRAM);
          __memcpy_async(
              four_gates, gate + (i - 3) * 128, sizeof(four_gates), GDRAM2NRAM);
        } else {
          for (int32_t member = 0; member < 4; ++member) {
            int64_t source = i - 3 + member;
            bool current = source >= request_start && positions[source] >= 0;
            if (current) {
              __memcpy_async(four_keys + member * 128,
                             key + source * 128,
                             256,
                             GDRAM2NRAM);
              __memcpy_async(four_gates + member * 128,
                             gate + source * 128,
                             256,
                             GDRAM2NRAM);
            } else {
              __bang_write_value(
                  four_keys + member * 128, 128, static_cast<bfloat16_t>(0));
              __bang_write_value(
                  four_gates + member * 128, 128, static_cast<bfloat16_t>(0));
            }
          }
        }
        __sync();
        pool_one(four_keys,
                 four_gates,
                 cache_bias ? bias_tile : ape,
                 cache_matrix ? matrix_tile : matrix,
                 tail,
                 3,
                 0,
                 pos,
                 state,
                 positions,
                 ring_size,
                 out,
                 four_keys + 384,
                 four_gates + 384,
                 false,
                 cache_matrix,
                 cache_bias,
                 true,
                 true);
      } else {
        __memcpy_async(kv, key + i * 128, 256, GDRAM2NRAM);
        __memcpy_async(gv, gate + i * 128, 256, GDRAM2NRAM);
        __sync_io();
        pool_one(key,
                 gate,
                 cache_bias ? bias_tile : ape,
                 cache_matrix ? matrix_tile : matrix,
                 tail,
                 i,
                 starts[req],
                 pos,
                 state,
                 positions,
                 ring_size,
                 out,
                 kv,
                 gv,
                 false,
                 cache_matrix,
                 cache_bias,
                 true);
      }
      int32_t block = table[req * table_width + pos / 16];
      if (block >= 0) {
        __memcpy(cache + (block * 4 + pos / 4 % 4) * 128, out, 256, NRAM2GDRAM);
      } else {
        // Skipped stores do not close Compute readers before the next IO load.
        __sync_compute();
      }
    }
  }
}
template <typename Id>
__mlu_global__ void stash_kernel(const bfloat16_t* key,
                                 const bfloat16_t* gate,
                                 bfloat16_t* tail,
                                 const Id* ids,
                                 const Id* read_ids,
                                 const int32_t* positions,
                                 const int64_t* starts,
                                 int32_t batch,
                                 int32_t ring_size,
                                 bool inherit) {
  __nram__ bfloat16_t kv[128], gv[128], shadow[2 * 64 * 128];
  __nram__ int32_t final_positions[64];
  for (int32_t req = taskId; req < batch; req += taskDim) {
    int64_t state = read_state_id(ids, req);
    if (state <= 0) {
      continue;
    }
    int64_t start = starts[req], end = starts[req + 1];
    while (end > start && positions[end - 1] < 0) {
      --end;
    }
    int32_t last = end > start ? positions[end - 1] : -1;
    if (ring_size <= 64) {
      int64_t source_state = inherit ? read_state_id(read_ids, req) : state;
      bool all_current = end - start >= ring_size;
      if (all_current) {
        __memcpy(final_positions,
                 positions + end - ring_size,
                 ring_size * sizeof(int32_t),
                 GDRAM2NRAM);
        for (int32_t slot = 0; slot < ring_size; ++slot) {
          if (final_positions[slot] < 0) {
            all_current = false;
            break;
          }
        }
      }
      if (all_current) {
        int32_t first_count = last % ring_size + 1;
        int32_t second_count = ring_size - first_count;
        __memcpy_async(shadow,
                       key + (end - first_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        __memcpy_async(shadow + ring_size * 128,
                       gate + (end - first_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        if (second_count > 0) {
          __memcpy_async(shadow + first_count * 128,
                         key + (end - ring_size) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
          __memcpy_async(shadow + (ring_size + first_count) * 128,
                         gate + (end - ring_size) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
        }
        __sync_io();
        __memcpy(tail + state * 2 * ring_size * 128,
                 shadow,
                 2 * ring_size * 256,
                 NRAM2GDRAM);
        continue;
      }
      if (!all_current && source_state > 0) {
        __memcpy(shadow,
                 tail + source_state * 2 * ring_size * 128,
                 2 * ring_size * 256,
                 GDRAM2NRAM);
      } else if (!all_current) {
        __bang_write_value(
            shadow, 2 * ring_size * 128, static_cast<bfloat16_t>(0));
        __sync_compute();
      }
      int32_t current_count = end - start < ring_size ? end - start : ring_size;
      bool contiguous_current = current_count > 0;
      if (current_count > 1) {
        __memcpy(final_positions,
                 positions + end - current_count,
                 current_count * sizeof(int32_t),
                 GDRAM2NRAM);
        for (int32_t slot = 0; slot < current_count; ++slot) {
          if (final_positions[slot] < 0) {
            contiguous_current = false;
          }
        }
      }
      if (contiguous_current) {
        int32_t first_slot =
            ((last - current_count + 1) % ring_size + ring_size) % ring_size;
        int32_t first_count = ring_size - first_slot < current_count
                                  ? ring_size - first_slot
                                  : current_count;
        int32_t second_count = current_count - first_count;
        __memcpy_async(shadow + first_slot * 128,
                       key + (end - current_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        __memcpy_async(shadow + (ring_size + first_slot) * 128,
                       gate + (end - current_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        if (second_count > 0) {
          __memcpy_async(shadow,
                         key + (end - second_count) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
          __memcpy_async(shadow + ring_size * 128,
                         gate + (end - second_count) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
        }
        __sync_io();
        __memcpy(tail + state * 2 * ring_size * 128,
                 shadow,
                 2 * ring_size * 256,
                 NRAM2GDRAM);
        continue;
      }
      for (int32_t r = 0; r < ring_size; ++r) {
        int64_t source =
            end - 1 -
            ((last % ring_size + ring_size) % ring_size - r + ring_size) %
                ring_size;
        bool current = end > start && source >= start && positions[source] >= 0;
        if (!current) {
          continue;
        }
        __memcpy_async(shadow + r * 128, key + source * 128, 256, GDRAM2NRAM);
        __memcpy_async(shadow + (ring_size + r) * 128,
                       gate + source * 128,
                       256,
                       GDRAM2NRAM);
      }
      __sync_io();
      __memcpy(tail + state * 2 * ring_size * 128,
               shadow,
               2 * ring_size * 256,
               NRAM2GDRAM);
      continue;
    }
    for (int32_t r = 0; r < ring_size; ++r) {
      int64_t source =
          end - 1 -
          ((last % ring_size + ring_size) % ring_size - r + ring_size) %
              ring_size;
      bool current = end > start && source >= start && positions[source] >= 0;
      if (current) {
        __memcpy(kv, key + source * 128, 256, GDRAM2NRAM);
        __memcpy(gv, gate + source * 128, 256, GDRAM2NRAM);
      } else if (inherit && read_state_id(read_ids, req) != state) {
        int64_t read_id = read_state_id(read_ids, req);
        if (read_id > 0) {
          __memcpy(
              kv, tail + (read_id * 2 * ring_size + r) * 128, 256, GDRAM2NRAM);
          __memcpy(gv,
                   tail + (read_id * 2 * ring_size + ring_size + r) * 128,
                   256,
                   GDRAM2NRAM);
        } else {
          __bang_write_value(kv, 128, static_cast<bfloat16_t>(0));
          __bang_write_value(gv, 128, static_cast<bfloat16_t>(0));
        }
      } else {
        continue;
      }
      __memcpy(tail + (state * 2 * ring_size + r) * 128, kv, 256, NRAM2GDRAM);
      __memcpy(tail + (state * 2 * ring_size + ring_size + r) * 128,
               gv,
               256,
               NRAM2GDRAM);
    }
  }
}
}  // namespace
extern "C" void kpool_prefill(void* queue,
                              const void* key,
                              const void* gate,
                              const void* ape,
                              const void* matrix,
                              void* cache,
                              void* tail,
                              const void* ids,
                              const void* read_ids,
                              const void* table,
                              const void* positions,
                              const void* starts,
                              const void* rows,
                              int32_t batch,
                              int32_t tokens,
                              int32_t table_width,
                              int32_t ring_size,
                              int32_t inherit) {
  cnrtDim3_t grid = {32, 1, 1};
  prefill_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const float*>(ape),
      static_cast<const float*>(matrix),
      static_cast<bfloat16_t*>(cache),
      static_cast<const bfloat16_t*>(tail),
      static_cast<const int64_t*>(read_ids),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      static_cast<const int64_t*>(rows),
      tokens,
      table_width,
      ring_size,
      batch,
      static_cast<const int64_t*>(ids));
  stash_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<bfloat16_t*>(tail),
      static_cast<const int64_t*>(ids),
      static_cast<const int64_t*>(read_ids),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      batch,
      ring_size,
      inherit != 0);
}

extern "C" void kpool_prefill_i32(void* queue,
                                  const void* key,
                                  const void* gate,
                                  const void* ape,
                                  const void* matrix,
                                  void* cache,
                                  void* tail,
                                  const void* ids,
                                  const void* read_ids,
                                  const void* table,
                                  const void* positions,
                                  const void* starts,
                                  const void* rows,
                                  int32_t batch,
                                  int32_t tokens,
                                  int32_t table_width,
                                  int32_t ring_size,
                                  int32_t inherit) {
  cnrtDim3_t grid = {32, 1, 1};
  prefill_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const float*>(ape),
      static_cast<const float*>(matrix),
      static_cast<bfloat16_t*>(cache),
      static_cast<const bfloat16_t*>(tail),
      static_cast<const int32_t*>(read_ids),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      static_cast<const int64_t*>(rows),
      tokens,
      table_width,
      ring_size,
      batch,
      static_cast<const int32_t*>(ids));
  stash_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<bfloat16_t*>(tail),
      static_cast<const int32_t*>(ids),
      static_cast<const int32_t*>(read_ids),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      batch,
      ring_size,
      inherit != 0);
}

namespace {
__mlu_global__ void score_kernel(const bfloat16_t* query,
                                 const float* weights,
                                 const bfloat16_t* cache,
                                 const int32_t* table,
                                 const int32_t* positions,
                                 const int64_t* rows,
                                 float* output,
                                 int32_t tokens,
                                 int32_t capacity,
                                 int32_t table_width,
                                 int32_t cache_blocks,
                                 float scale,
                                 int32_t batch) {
  constexpr int32_t kTile = 512;
  __mlu_shared__ bfloat16_t shared_query[32 * 128];
  __wram__ bfloat16_t query_filter[64 * 128];
  __nram__ bfloat16_t keys[kTile * 128];
  __nram__ float dot[kTile * 32], transposed[32 * kTile], scores[kTile],
      head_weights[32];
  __nram__ uint32_t valid[kTile];
  __nram__ int32_t page_table[kTile / 4], page_mask[kTile / 4],
      page_upper[kTile / 4];
  __nram__ uint32_t page_offsets[kTile / 4], repeated_mask[kTile];
  int32_t groups = capacity / (kTile * 4) + (capacity % (kTile * 4) != 0);
  for (int32_t token = taskIdY; token < tokens; token += taskDimY) {
    if (__is_mpu()) {
      __memcpy(shared_query,
               query + token * 32 * 128,
               sizeof(shared_query),
               GDRAM2SRAM);
    }
    __sync_cluster();
    if (!__is_mpu()) {
      __bang_load_matrix(
          query_filter, shared_query, SRAM2WRAM, 32, 128, 256, false);
      __memcpy(
          head_weights, weights + token * 32, sizeof(head_weights), GDRAM2NRAM);

      for (int32_t group = 0; group < groups; ++group) {
        int64_t first =
            static_cast<int64_t>(group) * (kTile * 4) + coreId * kTile;
        if (first >= capacity) {
          continue;
        }
        int32_t request = read_row_id(rows, token);
        request = request < batch ? request : -1;
        int32_t live = request >= 0 && positions[token] >= 0
                           ? (static_cast<int64_t>(positions[token]) + 1) / 4
                           : 0;
        live = live < capacity ? live : capacity;
        live = live < table_width * 4 ? live : table_width * 4;

        int32_t page_count = table_width - first / 4 < kTile / 4
                                 ? table_width - first / 4
                                 : kTile / 4;
        if (cache_blocks <= 4194304) {
          __bang_write_value(page_table, kTile / 4, -1);
          __sync_compute();
          if (page_count > 0 && request >= 0) {
            __memcpy(
                page_table,
                table + static_cast<int64_t>(request) * table_width + first / 4,
                page_count * 4,
                GDRAM2NRAM);
          }
          __bang_ge_scalar(page_mask, page_table, 0, kTile / 4);
          __bang_lt_scalar(page_upper, page_table, cache_blocks, kTile / 4);
          __bang_band(page_mask, page_mask, page_upper, kTile / 4);
          __bang_mul_scalar(page_mask, page_mask, -1, kTile / 4);
          __bang_band(page_offsets,
                      reinterpret_cast<uint32_t*>(page_table),
                      reinterpret_cast<uint32_t*>(page_mask),
                      kTile / 4);
          __bang_mul_scalar(page_offsets, page_offsets, 1024u, kTile / 4);
          if (cache_blocks > 0) {
            __sync_compute();
            __gather_async(
                keys, cache, page_offsets, 1024, GDRAM2NRAM, 1024, kTile / 4);
          } else {
            __bang_write_value(keys, kTile * 128, static_cast<bfloat16_t>(0));
          }
          __sync_compute();
          __memcpy_async(
              repeated_mask, page_mask, kTile, NRAM2NRAM, kTile, 0, 3);
          __sync_move();
          __bang_transpose(valid, repeated_mask, 4, kTile / 4);
          int32_t valid_count = live - first;
          valid_count =
              valid_count < 0 ? 0 : (valid_count > kTile ? kTile : valid_count);
          if (valid_count < kTile) {
            __bang_write_value(valid + valid_count, kTile - valid_count, 0u);
          }
        } else {
          if (page_count > 0 && request >= 0) {
            __memcpy(
                page_table,
                table + static_cast<int64_t>(request) * table_width + first / 4,
                page_count * 4,
                GDRAM2NRAM);
          }
          int32_t valid_count = live - first;
          valid_count =
              valid_count < 0 ? 0 : (valid_count > kTile ? kTile : valid_count);
          if (valid_count > 0) {
            __bang_write_value(valid, valid_count, 0xffffffffu);
          }
          if (valid_count < kTile) {
            __bang_write_value(valid + valid_count, kTile - valid_count, 0u);
          }
          for (int32_t page = 0; page < kTile / 4; ++page) {
            int32_t logical = first / 4 + page;
            int32_t physical = logical < table_width && logical * 4 < live
                                   ? page_table[page]
                                   : -1;
            bool present = physical >= 0 && physical < cache_blocks;
            if (!present) {
              __bang_write_value(valid + page * 4, 4, 0u);
            }
            if (present) {
              __memcpy_async(keys + page * 4 * 128,
                             cache + static_cast<int64_t>(physical) * 4 * 128,
                             4 * 256,
                             GDRAM2NRAM);
            } else {
              __bang_write_value(
                  keys + page * 4 * 128, 4 * 128, static_cast<bfloat16_t>(0));
            }
          }
        }
        __sync_io();
        __bang_conv(dot, keys, query_filter, 128, kTile, 1, 1, 1, 1, 1, 32);
        __bang_mul_scalar(dot, dot, scale, kTile * 32);
        __bang_relu(dot, dot, kTile * 32);
        __bang_cycle_mul(dot, dot, head_weights, kTile * 32, 32);
        __bang_transpose(transposed, dot, kTile, 32);
        __bang_sumpool(scores, transposed, kTile, 1, 32, 1, 32, 1, 1);
        __bang_band(reinterpret_cast<uint32_t*>(scores),
                    reinterpret_cast<uint32_t*>(scores),
                    valid,
                    kTile);
        __bang_bnot(valid, valid, kTile);
        __bang_band_scalar(valid, valid, 0xff800000u, kTile);
        __bang_bor(reinterpret_cast<uint32_t*>(scores),
                   reinterpret_cast<uint32_t*>(scores),
                   valid,
                   kTile);
        int32_t count = capacity - first < kTile ? capacity - first : kTile;
        __memcpy(
            output + token * capacity + first, scores, count * 4, NRAM2GDRAM);
      }
    }
    __sync_cluster();
  }
}
template <int32_t Tile>
__mlu_global__ void score_split_kernel(const bfloat16_t* query,
                                       const float* weights,
                                       const bfloat16_t* cache,
                                       const int32_t* table,
                                       const int32_t* positions,
                                       const int64_t* rows,
                                       float* output,
                                       int32_t tokens,
                                       int32_t capacity,
                                       int32_t table_width,
                                       int32_t cache_blocks,
                                       float scale,
                                       int32_t batch) {
  constexpr int32_t kTile = Tile;
  __mlu_shared__ bfloat16_t shared_query[32 * 128];
  __wram__ bfloat16_t query_filter[64 * 128];
  __nram__ bfloat16_t keys[kTile * 128];
  __nram__ float dot[kTile * 32], transposed[32 * kTile], scores[kTile],
      head_weights[32];
  __nram__ uint32_t valid[kTile];
  __nram__ int32_t page_table[kTile / 4], page_mask[kTile / 4],
      page_upper[kTile / 4];
  __nram__ uint32_t page_offsets[kTile / 4], repeated_mask[kTile];
  int32_t groups = capacity / (kTile * 4) + (capacity % (kTile * 4) != 0);
  int32_t chunk = static_cast<int32_t>(
      (static_cast<int64_t>(tokens) * groups + taskDimY - 1) / taskDimY);
  int32_t work_begin = taskIdY * chunk;
  int32_t work_end = work_begin + chunk;
  work_end = work_end < tokens * groups ? work_end : tokens * groups;
  for (int32_t token = work_begin / groups;
       token < tokens && token * groups < work_end;
       ++token) {
    int32_t group_begin = work_begin - token * groups;
    group_begin = group_begin > 0 ? group_begin : 0;
    int32_t group_end = work_end - token * groups;
    group_end = group_end < groups ? group_end : groups;
    if (__is_mpu()) {
      __memcpy(shared_query,
               query + token * 32 * 128,
               sizeof(shared_query),
               GDRAM2SRAM);
    }
    __sync_cluster();
    if (!__is_mpu()) {
      __bang_load_matrix(
          query_filter, shared_query, SRAM2WRAM, 32, 128, 256, false);
      __memcpy(
          head_weights, weights + token * 32, sizeof(head_weights), GDRAM2NRAM);

      for (int32_t group = group_begin; group < group_end; ++group) {
        int64_t first =
            static_cast<int64_t>(group) * (kTile * 4) + coreId * kTile;
        if (first >= capacity) {
          continue;
        }
        int32_t request = read_row_id(rows, token);
        request = request < batch ? request : -1;
        int32_t live = request >= 0 && positions[token] >= 0
                           ? (static_cast<int64_t>(positions[token]) + 1) / 4
                           : 0;
        live = live < capacity ? live : capacity;
        live = live < table_width * 4 ? live : table_width * 4;

        int32_t page_count = table_width - first / 4 < kTile / 4
                                 ? table_width - first / 4
                                 : kTile / 4;
        if (cache_blocks <= 4194304) {
          __bang_write_value(page_table, kTile / 4, -1);
          __sync_compute();
          if (page_count > 0 && request >= 0) {
            __memcpy(
                page_table,
                table + static_cast<int64_t>(request) * table_width + first / 4,
                page_count * 4,
                GDRAM2NRAM);
          }
          __bang_ge_scalar(page_mask, page_table, 0, kTile / 4);
          __bang_lt_scalar(page_upper, page_table, cache_blocks, kTile / 4);
          __bang_band(page_mask, page_mask, page_upper, kTile / 4);
          __bang_mul_scalar(page_mask, page_mask, -1, kTile / 4);
          __bang_band(page_offsets,
                      reinterpret_cast<uint32_t*>(page_table),
                      reinterpret_cast<uint32_t*>(page_mask),
                      kTile / 4);
          __bang_mul_scalar(page_offsets, page_offsets, 1024u, kTile / 4);
          if (cache_blocks > 0) {
            __sync_compute();
            __gather_async(
                keys, cache, page_offsets, 1024, GDRAM2NRAM, 1024, kTile / 4);
          } else {
            __bang_write_value(keys, kTile * 128, static_cast<bfloat16_t>(0));
          }
          __sync_compute();
          __memcpy_async(
              repeated_mask, page_mask, kTile, NRAM2NRAM, kTile, 0, 3);
          __sync_move();
          __bang_transpose(valid, repeated_mask, 4, kTile / 4);
          int32_t valid_count = live - first;
          valid_count =
              valid_count < 0 ? 0 : (valid_count > kTile ? kTile : valid_count);
          if (valid_count < kTile) {
            __bang_write_value(valid + valid_count, kTile - valid_count, 0u);
          }
        } else {
          if (page_count > 0 && request >= 0) {
            __memcpy(
                page_table,
                table + static_cast<int64_t>(request) * table_width + first / 4,
                page_count * 4,
                GDRAM2NRAM);
          }
          int32_t valid_count = live - first;
          valid_count =
              valid_count < 0 ? 0 : (valid_count > kTile ? kTile : valid_count);
          if (valid_count > 0) {
            __bang_write_value(valid, valid_count, 0xffffffffu);
          }
          if (valid_count < kTile) {
            __bang_write_value(valid + valid_count, kTile - valid_count, 0u);
          }
          for (int32_t page = 0; page < kTile / 4; ++page) {
            int32_t logical = first / 4 + page;
            int32_t physical = logical < table_width && logical * 4 < live
                                   ? page_table[page]
                                   : -1;
            bool present = physical >= 0 && physical < cache_blocks;
            if (!present) {
              __bang_write_value(valid + page * 4, 4, 0u);
            }
            if (present) {
              __memcpy_async(keys + page * 4 * 128,
                             cache + static_cast<int64_t>(physical) * 4 * 128,
                             4 * 256,
                             GDRAM2NRAM);
            } else {
              __bang_write_value(
                  keys + page * 4 * 128, 4 * 128, static_cast<bfloat16_t>(0));
            }
          }
        }
        __sync_io();
        __bang_conv(dot, keys, query_filter, 128, kTile, 1, 1, 1, 1, 1, 32);
        __bang_mul_scalar(dot, dot, scale, kTile * 32);
        __bang_relu(dot, dot, kTile * 32);
        __bang_cycle_mul(dot, dot, head_weights, kTile * 32, 32);
        __bang_transpose(transposed, dot, kTile, 32);
        __bang_sumpool(scores, transposed, kTile, 1, 32, 1, 32, 1, 1);
        __bang_band(reinterpret_cast<uint32_t*>(scores),
                    reinterpret_cast<uint32_t*>(scores),
                    valid,
                    kTile);
        __bang_bnot(valid, valid, kTile);
        __bang_band_scalar(valid, valid, 0xff800000u, kTile);
        __bang_bor(reinterpret_cast<uint32_t*>(scores),
                   reinterpret_cast<uint32_t*>(scores),
                   valid,
                   kTile);
        int32_t count = capacity - first < kTile ? capacity - first : kTile;
        __memcpy(
            output + token * capacity + first, scores, count * 4, NRAM2GDRAM);
      }
    }
    __sync_cluster();
  }
}
template <int32_t Tile, int32_t MaxQueries>
__mlu_func__ void grouped_score_body(void* storage,
                                     const bfloat16_t* shared_query,
                                     const float* weights,
                                     const bfloat16_t* cache,
                                     const int32_t* table,
                                     const int32_t* positions,
                                     const int64_t* rows,
                                     float* output,
                                     int32_t begin,
                                     int32_t count,
                                     int32_t capacity,
                                     int32_t table_width,
                                     int32_t cache_blocks,
                                     float scale,
                                     int32_t batch,
                                     int32_t group_begin = 0,
                                     int32_t group_end = -1) {
  constexpr int32_t kTile = Tile;
  // Matrix-load rows are physically padded to a multiple of 64 heads.
  constexpr int32_t kPhysicalHeads = ((MaxQueries * 32 + 63) / 64) * 64;
  __wram__ bfloat16_t query_filter[kPhysicalHeads * 128];
  uint8_t* cursor = static_cast<uint8_t*>(storage);
  bfloat16_t* keys = reinterpret_cast<bfloat16_t*>(cursor);
  cursor += (kTile * 128) * sizeof(bfloat16_t);
  float* dot = reinterpret_cast<float*>(cursor);
  cursor += (kTile * MaxQueries * 32) * sizeof(float);
  float* transposed = reinterpret_cast<float*>(cursor);
  cursor += (kTile * MaxQueries * 32) * sizeof(float);
  float* scores = reinterpret_cast<float*>(cursor);
  cursor += (MaxQueries * kTile) * sizeof(float);
  float* ordered = reinterpret_cast<float*>(cursor);
  cursor += (MaxQueries * kTile) * sizeof(float);
  float* head_weights = reinterpret_cast<float*>(cursor);
  cursor += (MaxQueries * 32) * sizeof(float);
  int32_t* pages = reinterpret_cast<int32_t*>(cursor);
  cursor += (kTile / 4) * sizeof(int32_t);
  int32_t* present = reinterpret_cast<int32_t*>(cursor);
  cursor += (kTile / 4) * sizeof(int32_t);
  int32_t* upper = reinterpret_cast<int32_t*>(cursor);
  cursor += (kTile / 4) * sizeof(int32_t);
  uint32_t* offsets = reinterpret_cast<uint32_t*>(cursor);
  cursor += (kTile / 4) * sizeof(uint32_t);
  uint32_t* repeated = reinterpret_cast<uint32_t*>(cursor);
  cursor += (kTile) * sizeof(uint32_t);
  uint32_t* valid = reinterpret_cast<uint32_t*>(cursor);
  cursor += (kTile) * sizeof(uint32_t);
  uint32_t* row_valid = reinterpret_cast<uint32_t*>(cursor);
  cursor += (kTile) * sizeof(uint32_t);
  int32_t groups = capacity / (kTile * 4) + (capacity % (kTile * 4) != 0);

  if (count > 0) {
    int32_t heads = MaxQueries == 1 ? 32 : count * 32;
    __bang_load_matrix(
        query_filter, shared_query, SRAM2WRAM, heads, 128, 256, false);
    __memcpy(head_weights, weights + begin * 32, heads * 4, GDRAM2NRAM);
  }
  int32_t request = count > 0 ? read_row_id(rows, begin) : -1;
  request = request < batch ? request : -1;
  bool request_valid = request >= 0;
  int32_t safe_request = request_valid ? request : 0;
  int32_t end_group = group_end < 0 || group_end > groups ? groups : group_end;
  for (int32_t group = group_begin; group < end_group; ++group) {
    int64_t first = static_cast<int64_t>(group) * (kTile * 4) + coreId * kTile;
    if (first >= capacity) {
      continue;
    }
    int32_t store_count = capacity - first < kTile ? capacity - first : kTile;
    if (count > 0) {
      int32_t heads = MaxQueries == 1 ? 32 : count * 32;
      int32_t page_count = table_width - first / 4 < kTile / 4
                               ? table_width - first / 4
                               : kTile / 4;
      if (page_count < kTile / 4 || !request_valid) {
        __bang_write_value(pages, kTile / 4, -1);
        __sync_compute();
      }
      if (page_count > 0 && request_valid) {
        __memcpy(pages,
                 table + static_cast<int64_t>(safe_request) * table_width +
                     first / 4,
                 page_count * 4,
                 GDRAM2NRAM);
      }
      __bang_ge_scalar(present, pages, 0, kTile / 4);
      __bang_lt_scalar(upper, pages, cache_blocks, kTile / 4);
      __bang_band(present, present, upper, kTile / 4);
      __bang_mul_scalar(present, present, -1, kTile / 4);
      __bang_band(offsets,
                  reinterpret_cast<uint32_t*>(pages),
                  reinterpret_cast<uint32_t*>(present),
                  kTile / 4);
      __bang_mul_scalar(offsets, offsets, 1024u, kTile / 4);
      if (cache_blocks > 0) {
        __sync_compute();
        __gather_async(keys, cache, offsets, 1024, GDRAM2NRAM, 1024, kTile / 4);
      } else {
        __bang_write_value(keys, kTile * 128, static_cast<bfloat16_t>(0));
      }
      __sync_compute();
      __memcpy_async(repeated, present, kTile, NRAM2NRAM, kTile, 0, 3);
      __sync_move();
      __bang_transpose(valid, repeated, 4, kTile / 4);
      __sync_io();
      __bang_conv(dot, keys, query_filter, 128, kTile, 1, 1, 1, 1, 1, heads);
      __bang_mul_scalar(dot, dot, scale, kTile * heads);
      __bang_relu(dot, dot, kTile * heads);
      __bang_cycle_mul(dot, dot, head_weights, kTile * heads, heads);
      __bang_transpose(transposed, dot, kTile * count, 32);
      __bang_sumpool(scores, transposed, kTile * count, 1, 32, 1, 32, 1, 1);
      if constexpr (MaxQueries == 1) {
        int32_t live = positions[begin] >= 0
                           ? (static_cast<int64_t>(positions[begin]) + 1) / 4
                           : 0;
        live = live < table_width * 4 ? live : table_width * 4;
        int32_t active = live - first;
        active = active < 0 ? 0 : (active > kTile ? kTile : active);
        if (active < kTile) {
          __bang_write_value(valid + active, kTile - active, 0u);
        }
        uint32_t* bits = reinterpret_cast<uint32_t*>(scores);
        __bang_band(bits, bits, valid, kTile);
        __bang_bnot(valid, valid, kTile);
        __bang_band_scalar(valid, valid, 0xff800000u, kTile);
        __bang_bor(bits, bits, valid, kTile);
        // The single-query mask must finish before IO reads scores, and before
        // the following row group reuses the same NRAM scratch.
        __sync_compute();
        __memcpy(output + static_cast<int64_t>(begin) * capacity + first,
                 bits,
                 store_count * 4,
                 NRAM2GDRAM);
      } else {
        __bang_transpose(ordered, scores, kTile, count);
        for (int32_t q = 0; q < count; ++q) {
          int32_t live =
              positions[begin + q] >= 0
                  ? (static_cast<int64_t>(positions[begin + q]) + 1) / 4
                  : 0;
          live = live < table_width * 4 ? live : table_width * 4;
          int32_t active = live - first;
          active = active < 0 ? 0 : (active > kTile ? kTile : active);
          __memcpy(row_valid, valid, kTile * sizeof(uint32_t), NRAM2NRAM);
          if (active < kTile) {
            __bang_write_value(row_valid + active, kTile - active, 0u);
          }
          uint32_t* bits = reinterpret_cast<uint32_t*>(ordered + q * kTile);
          __bang_band(bits, bits, row_valid, kTile);
          __bang_bnot(row_valid, row_valid, kTile);
          __bang_band_scalar(row_valid, row_valid, 0xff800000u, kTile);
          __bang_bor(bits, bits, row_valid, kTile);
        }
        // Every mask producer completes before any IO consumer reads ordered.
        __sync_compute();
        for (int32_t q = 0; q < count; ++q) {
          __memcpy_async(
              output + static_cast<int64_t>(begin + q) * capacity + first,
              ordered + q * kTile,
              store_count * 4,
              NRAM2GDRAM);
        }
        // The following tile reuses ordered and its underlying scratch.
        __sync_io();
      }
    }
  }
}
__mlu_global__ void grouped_score_kernel(const bfloat16_t* query,
                                         const float* weights,
                                         const bfloat16_t* cache,
                                         const int32_t* table,
                                         const int32_t* positions,
                                         const int64_t* rows,
                                         float* output,
                                         int32_t tokens,
                                         int32_t capacity,
                                         int32_t table_width,
                                         int32_t cache_blocks,
                                         float scale,
                                         int32_t batch) {
  __mlu_shared__ bfloat16_t shared_query[128 * 128];
  __nram__ uint8_t scratch[352 * 1024];
  // Disjoint contiguous partitions avoid a new request fragment at every
  // globally aligned four-query boundary. Every query belongs to one cluster.
  int32_t chunk = tokens / taskDimY + (tokens % taskDimY != 0);
  int32_t tile_begin = taskIdY * chunk;
  int32_t tile_end = tile_begin + chunk < tokens ? tile_begin + chunk : tokens;
  {
    for (int32_t begin = tile_begin; begin < tile_end;) {
      int32_t count = 1;
      while (count < 4 && begin + count < tile_end &&
             read_row_id(rows, begin + count) == read_row_id(rows, begin)) {
        ++count;
      }
      if (__is_mpu()) {
        __memcpy(shared_query,
                 query + static_cast<int64_t>(begin) * 4096,
                 count * 8192,
                 GDRAM2SRAM);
      }
      __sync_cluster();
      if (!__is_mpu()) {
        if (count == 1) {
          grouped_score_body<512, 1>(scratch,
                                     shared_query,
                                     weights,
                                     cache,
                                     table,
                                     positions,
                                     rows,
                                     output,
                                     begin,
                                     1,
                                     capacity,
                                     table_width,
                                     cache_blocks,
                                     scale,
                                     batch);
        } else {
          grouped_score_body<256, 4>(scratch,
                                     shared_query,
                                     weights,
                                     cache,
                                     table,
                                     positions,
                                     rows,
                                     output,
                                     begin,
                                     count,
                                     capacity,
                                     table_width,
                                     cache_blocks,
                                     scale,
                                     batch);
        }
      }
      __sync_cluster();
      begin += count;
    }
  }
}

}  // namespace
namespace {
// Small query batches need capacity parallelism as well as row reuse. Discover
// actual contiguous row groups on the device rather than inferring them from
// starts or from the total token count. Each query belongs to exactly one
// group.
__mlu_global__ void small_grouped_score_kernel(const bfloat16_t* query,
                                               const float* weights,
                                               const bfloat16_t* cache,
                                               const int32_t* table,
                                               const int32_t* positions,
                                               const int64_t* rows,
                                               float* output,
                                               int32_t tokens,
                                               int32_t capacity,
                                               int32_t table_width,
                                               int32_t cache_blocks,
                                               float scale,
                                               int32_t batch) {
  __mlu_shared__ bfloat16_t shared_query[128 * 128];
  __nram__ uint8_t scratch[352 * 1024];
  __mlu_shared__ int32_t shared_row_words[64];
  if (__is_mpu()) {
    __memcpy(shared_row_words, rows, tokens * sizeof(int64_t), GDRAM2SRAM);
    if (tokens == 4) {
      // The entire query tensor fits this existing SRAM allocation. Keeping it
      // immutable removes per-group refill barriers, including mixed rows.
      __memcpy(shared_query, query, 4 * 8192, GDRAM2SRAM);
    }
  }
  // Every role observes the complete immutable metadata snapshot before
  // selecting groups or entering any group-specific cluster barrier.
  __sync_cluster();
  int32_t query_groups = 0;
  for (int32_t begin = 0; begin < tokens;) {
    int32_t count = 1;
    int32_t row = read_shared_row_id(shared_row_words, begin);
    while (count < 4 && begin + count < tokens &&
           read_shared_row_id(shared_row_words, begin + count) == row) {
      ++count;
    }
    begin += count;
    ++query_groups;
  }
  int32_t capacity_groups = capacity / 1024 + (capacity % 1024 != 0);
  int64_t total_groups = static_cast<int64_t>(query_groups) * capacity_groups;
  int64_t chunk = total_groups / taskDimY + (total_groups % taskDimY != 0);
  int64_t work_begin = taskIdY * chunk;
  int64_t work_end = work_begin + chunk;
  int32_t group_id = 0;
  for (int32_t begin = 0; begin < tokens;) {
    int32_t count = 1;
    int32_t row = read_shared_row_id(shared_row_words, begin);
    while (count < 4 && begin + count < tokens &&
           read_shared_row_id(shared_row_words, begin + count) == row) {
      ++count;
    }
    int64_t first_group = static_cast<int64_t>(group_id) * capacity_groups;
    int64_t begin_group = work_begin - first_group;
    int64_t end_group = work_end - first_group;
    begin_group = begin_group < 0 ? 0 : begin_group;
    end_group = end_group > capacity_groups ? capacity_groups : end_group;
    if (begin_group < end_group) {
      int32_t group_begin = static_cast<int32_t>(begin_group);
      int32_t group_end = static_cast<int32_t>(end_group);
      if (tokens != 4) {
        if (__is_mpu()) {
          __memcpy(shared_query,
                   query + static_cast<int64_t>(begin) * 4096,
                   count * 8192,
                   GDRAM2SRAM);
        }
        __sync_cluster();
      }
      const bfloat16_t* group_query =
          tokens == 4 ? shared_query + begin * 4096 : shared_query;
      if (!__is_mpu()) {
        if (count == 1) {
          grouped_score_body<256, 1>(scratch,
                                     group_query,
                                     weights,
                                     cache,
                                     table,
                                     positions,
                                     rows,
                                     output,
                                     begin,
                                     count,
                                     capacity,
                                     table_width,
                                     cache_blocks,
                                     scale,
                                     batch,
                                     group_begin,
                                     group_end);
        } else {
          grouped_score_body<256, 4>(scratch,
                                     group_query,
                                     weights,
                                     cache,
                                     table,
                                     positions,
                                     rows,
                                     output,
                                     begin,
                                     count,
                                     capacity,
                                     table_width,
                                     cache_blocks,
                                     scale,
                                     batch,
                                     group_begin,
                                     group_end);
        }
      }
      if (tokens != 4) {
        __sync_cluster();
      }
    }
    begin += count;
    ++group_id;
  }
}
}  // namespace

namespace {
void launch_score_with_bounds(void* queue,
                              const void* query,
                              const void* weights,
                              const void* cache,
                              const void* table,
                              const void* positions,
                              const void* rows,
                              void* output,
                              int32_t tokens,
                              int32_t capacity,
                              int32_t table_width,
                              int32_t cache_blocks,
                              float scale,
                              int32_t batch) {
  cnrtDim3_t grid = {4, 8, 1};
  if (tokens >= 4 && tokens < 32 && cache_blocks <= 4194304) {
    small_grouped_score_kernel<<<grid,
                                 cnrtFuncTypeUnion1,
                                 static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const bfloat16_t*>(query),
        static_cast<const float*>(weights),
        static_cast<const bfloat16_t*>(cache),
        static_cast<const int32_t*>(table),
        static_cast<const int32_t*>(positions),
        static_cast<const int64_t*>(rows),
        static_cast<float*>(output),
        tokens,
        capacity,
        table_width,
        cache_blocks,
        scale,
        batch);
    return;
  }
  if (tokens >= 32 && cache_blocks <= 4194304) {
    grouped_score_kernel<<<grid,
                           cnrtFuncTypeUnion1,
                           static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const bfloat16_t*>(query),
        static_cast<const float*>(weights),
        static_cast<const bfloat16_t*>(cache),
        static_cast<const int32_t*>(table),
        static_cast<const int32_t*>(positions),
        static_cast<const int64_t*>(rows),
        static_cast<float*>(output),
        tokens,
        capacity,
        table_width,
        cache_blocks,
        scale,
        batch);
    return;
  }
  int64_t target = static_cast<int64_t>(tokens) * capacity;
  int32_t groups = capacity / 2048 + (capacity % 2048 != 0);
  if (tokens < 8 &&
      (target <= 8192 ||
       (static_cast<int64_t>(tokens) * groups + 7) / 8 < groups)) {
    if (target <= 4096) {
      score_split_kernel<128>
          <<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(query),
              static_cast<const float*>(weights),
              static_cast<const bfloat16_t*>(cache),
              static_cast<const int32_t*>(table),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(rows),
              static_cast<float*>(output),
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale,
              batch);
    } else if (target <= 8192) {
      score_split_kernel<256>
          <<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(query),
              static_cast<const float*>(weights),
              static_cast<const bfloat16_t*>(cache),
              static_cast<const int32_t*>(table),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(rows),
              static_cast<float*>(output),
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale,
              batch);
    } else {
      score_split_kernel<512>
          <<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(query),
              static_cast<const float*>(weights),
              static_cast<const bfloat16_t*>(cache),
              static_cast<const int32_t*>(table),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(rows),
              static_cast<float*>(output),
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale,
              batch);
    }
    return;
  }
  score_kernel<<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(query),
      static_cast<const float*>(weights),
      static_cast<const bfloat16_t*>(cache),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(rows),
      static_cast<float*>(output),
      tokens,
      capacity,
      table_width,
      cache_blocks,
      scale,
      batch);
}
void launch_score_unshared_with_bounds(void* queue,
                                       const void* query,
                                       const void* weights,
                                       const void* cache,
                                       const void* table,
                                       const void* positions,
                                       const void* rows,
                                       void* output,
                                       int32_t tokens,
                                       int32_t capacity,
                                       int32_t table_width,
                                       int32_t cache_blocks,
                                       float scale,
                                       int32_t batch) {
  cnrtDim3_t grid = {4, 8, 1};
  int64_t target = static_cast<int64_t>(tokens) * capacity;
  int32_t groups = capacity / 2048 + (capacity % 2048 != 0);
  if (tokens < 8 &&
      (target <= 8192 ||
       (static_cast<int64_t>(tokens) * groups + 7) / 8 < groups)) {
    if (target <= 4096) {
      score_split_kernel<128>
          <<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(query),
              static_cast<const float*>(weights),
              static_cast<const bfloat16_t*>(cache),
              static_cast<const int32_t*>(table),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(rows),
              static_cast<float*>(output),
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale,
              batch);
    } else if (target <= 8192) {
      score_split_kernel<256>
          <<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(query),
              static_cast<const float*>(weights),
              static_cast<const bfloat16_t*>(cache),
              static_cast<const int32_t*>(table),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(rows),
              static_cast<float*>(output),
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale,
              batch);
    } else {
      score_split_kernel<512>
          <<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(query),
              static_cast<const float*>(weights),
              static_cast<const bfloat16_t*>(cache),
              static_cast<const int32_t*>(table),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(rows),
              static_cast<float*>(output),
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale,
              batch);
    }
    return;
  }
  score_kernel<<<grid, cnrtFuncTypeUnion1, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(query),
      static_cast<const float*>(weights),
      static_cast<const bfloat16_t*>(cache),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(rows),
      static_cast<float*>(output),
      tokens,
      capacity,
      table_width,
      cache_blocks,
      scale,
      batch);
}

}  // namespace

extern "C" void kpool_score(void* queue,
                            const void* query,
                            const void* weights,
                            const void* cache,
                            const void* table,
                            const void* positions,
                            const void* rows,
                            void* output,
                            int32_t tokens,
                            int32_t capacity,
                            int32_t table_width,
                            int32_t cache_blocks,
                            float scale) {
  launch_score_with_bounds(queue,
                           query,
                           weights,
                           cache,
                           table,
                           positions,
                           rows,
                           output,
                           tokens,
                           capacity,
                           table_width,
                           cache_blocks,
                           scale,
                           INT32_MAX);
}
extern "C" void kpool_score_bounded(void* queue,
                                    const void* query,
                                    const void* weights,
                                    const void* cache,
                                    const void* table,
                                    const void* positions,
                                    const void* rows,
                                    void* output,
                                    int32_t tokens,
                                    int32_t capacity,
                                    int32_t table_width,
                                    int32_t cache_blocks,
                                    int32_t batch,
                                    float scale) {
  launch_score_with_bounds(queue,
                           query,
                           weights,
                           cache,
                           table,
                           positions,
                           rows,
                           output,
                           tokens,
                           capacity,
                           table_width,
                           cache_blocks,
                           scale,
                           batch);
}
extern "C" void kpool_score_unshared(void* queue,
                                     const void* query,
                                     const void* weights,
                                     const void* cache,
                                     const void* table,
                                     const void* positions,
                                     const void* rows,
                                     void* output,
                                     int32_t tokens,
                                     int32_t capacity,
                                     int32_t table_width,
                                     int32_t cache_blocks,
                                     float scale) {
  launch_score_unshared_with_bounds(queue,
                                    query,
                                    weights,
                                    cache,
                                    table,
                                    positions,
                                    rows,
                                    output,
                                    tokens,
                                    capacity,
                                    table_width,
                                    cache_blocks,
                                    scale,
                                    INT32_MAX);
}
extern "C" void kpool_score_unshared_bounded(void* queue,
                                             const void* query,
                                             const void* weights,
                                             const void* cache,
                                             const void* table,
                                             const void* positions,
                                             const void* rows,
                                             void* output,
                                             int32_t tokens,
                                             int32_t capacity,
                                             int32_t table_width,
                                             int32_t cache_blocks,
                                             int32_t batch,
                                             float scale) {
  launch_score_unshared_with_bounds(queue,
                                    query,
                                    weights,
                                    cache,
                                    table,
                                    positions,
                                    rows,
                                    output,
                                    tokens,
                                    capacity,
                                    table_width,
                                    cache_blocks,
                                    scale,
                                    batch);
}
namespace {
template <bool Prefill = false,
          int32_t QueryChunk = 1,
          bool ReusePrefix = false,
          bool BalanceTail = false,
          typename LoopIndex = int64_t>
__mlu_global__ void expand_kernel(const int64_t* selected,
                                  const int32_t* positions,
                                  const int64_t* rows,
                                  const int32_t* table,
                                  int32_t* output,
                                  int32_t* lengths,
                                  int32_t tokens,
                                  int32_t table_width,
                                  bool append_tail,
                                  int32_t batch = INT32_MAX) {
  __nram__ int64_t pools[512];
  __nram__ int32_t slots[2051], low[512], high[512], valid[512], upper[512],
      pages[512];
  __nram__ uint32_t offsets[512];
  __nram__ int32_t cached_table[8192];
  __nram__ int32_t mapped[2048], interleaved[2048], member_mask[2048];
  __nram__ float mask[2048], ordered_mask[2048];
  int32_t cached_request = -1, loaded_pages = 0;
  const LoopIndex round_rows = static_cast<LoopIndex>(taskDim) * QueryChunk;
  const LoopIndex full_rows = tokens / round_rows * round_rows;
  for (LoopIndex base = taskId * QueryChunk; base < tokens;) {
    int32_t query_count = QueryChunk;
    if constexpr (BalanceTail) {
      if (base >= full_rows) {
        query_count = 1;
      }
    }
    for (int32_t offset = 0; offset < query_count && base + offset < tokens;
         ++offset) {
      LoopIndex token = base + offset;
      __bang_write_value(slots, 2051, -1);
      if constexpr (!BalanceTail) {
        // Complete rounds retain the original DMA/compute overlap: load the
        // selection before queuing the reusable block-table prefix.
        __memcpy(pools,
                 selected + static_cast<int64_t>(token) * 512,
                 sizeof(pools),
                 GDRAM2NRAM);
      }
      int32_t position = positions[token];
      if constexpr (!Prefill) {
        // Padding can have row -1. Like Triton masked loads, do not access
        // the block table when every selected pool and tail token is invalid.
        if (position < 0) {
          __memcpy(output + static_cast<int64_t>(token) * 2051,
                   slots,
                   sizeof(slots),
                   NRAM2GDRAM);
          lengths[token] = 0;
          continue;
        }
      }
      // Valid request IDs fit signed int32 by the host batch contract. Read
      // both stored words explicitly: native int64 scalar conversion/compare
      // on this device cannot be used to validate arbitrary int64 payloads.
      const AliasInt32* row_words = reinterpret_cast<const AliasInt32*>(rows);
      int32_t request = row_words[static_cast<int64_t>(token) * 2];
      int32_t request_high = row_words[static_cast<int64_t>(token) * 2 + 1];
      if (request_high != 0 || request < 0 || request >= batch) {
        __memcpy(output + static_cast<int64_t>(token) * 2051,
                 slots,
                 sizeof(slots),
                 NRAM2GDRAM);
        lengths[token] = 0;
        continue;
      }
      int32_t cached_pages = table_width;
      if constexpr (!Prefill) {
        // Decode rejects selections beyond this query position before
        // gathering.
        int32_t live_pages = position >= 0 ? position / 16 + 1 : 1;
        cached_pages = live_pages < table_width ? live_pages : table_width;
      }
      if (cached_pages <= 8192 && (!ReusePrefix || cached_request != request ||
                                   loaded_pages < cached_pages)) {
        __memcpy_async(cached_table,
                       table + static_cast<int64_t>(request) * table_width,
                       cached_pages * 4,
                       GDRAM2NRAM);
        if constexpr (ReusePrefix) {
          cached_request = request;
          loaded_pages = cached_pages;
        }
      }
      // Queue the table prefix before the synchronous selected-pool load, so
      // the same completion boundary releases both immutable input buffers.
      if constexpr (BalanceTail) {
        __memcpy(pools,
                 selected + static_cast<int64_t>(token) * 512,
                 sizeof(pools),
                 GDRAM2NRAM);
      }
      __memcpy(low, pools, 4, NRAM2NRAM, 4, 8, 511);
      if constexpr (Prefill) {
        __bang_ge_scalar(valid, low, 0, 512);
      } else {
        __memcpy(high,
                 reinterpret_cast<int32_t*>(pools) + 1,
                 4,
                 NRAM2NRAM,
                 4,
                 8,
                 511);
        __bang_eq_scalar(valid, high, 0, 512);
        __bang_ge_scalar(upper, low, 0, 512);
        __bang_band(valid, valid, upper, 512);
        int32_t limit = position >= 0 ? position / 4 : -1;
        limit = limit < table_width * 4 - 1 ? limit : table_width * 4 - 1;
        __bang_le_scalar(upper, low, limit, 512);
        __bang_band(valid, valid, upper, 512);
      }
      __bang_mul_scalar(upper, valid, -1, 512);
      __bang_band(offsets,
                  reinterpret_cast<uint32_t*>(low),
                  reinterpret_cast<uint32_t*>(upper),
                  512);
      __bang_band_scalar(offsets, offsets, 0xfffffffcu, 512);
      if constexpr (Prefill) {
        __bang_gt_scalar(upper,
                         reinterpret_cast<int32_t*>(offsets),
                         (table_width - 1) * 4,
                         512);
        __bang_mul_scalar(upper, upper, -1, 512);
        __bang_band_scalar(high, upper, (table_width - 1) * 4, 512);
        __bang_bnot(upper, upper, 512);
        __bang_band(offsets, offsets, reinterpret_cast<uint32_t*>(upper), 512);
        __bang_bor(offsets, offsets, reinterpret_cast<uint32_t*>(high), 512);
      }
      if (cached_pages <= 8192) {
        __sync_io();
        __gather(pages, cached_table, offsets, 4, NRAM2NRAM, 4, 512);
      } else {
        __gather(pages,
                 table + static_cast<int64_t>(request) * table_width,
                 offsets,
                 4,
                 GDRAM2NRAM,
                 4,
                 512);
      }
      if constexpr (!Prefill) {
        __bang_ge_scalar(upper, pages, 0, 512);
        __bang_band(valid, valid, upper, 512);
      }
      __bang_mul_scalar(pages, pages, 16, 512);
      __bang_band_scalar(upper, low, 3, 512);
      __bang_mul_scalar(upper, upper, 4, 512);
      __bang_add(pages, pages, upper, 512);
      int32_t count = 0;
      if constexpr (Prefill) {
        __bang_int322float(mask, valid, 512, 0);
        __bang_write_value(low, 512, 0);
        int32_t pool_count = __bang_filter(reinterpret_cast<float*>(low),
                                           reinterpret_cast<float*>(pages),
                                           mask,
                                           512);
        for (int32_t member = 0; member < 4; ++member) {
          __bang_add_scalar(mapped + member * 512, low, member, 512);
        }
        __bang_transpose(interleaved, mapped, 4, 512);
        count = pool_count * 4;
        if (count > 0) {
          __memcpy(slots, interleaved, count * 4, NRAM2NRAM);
        }
      } else {
        __bang_mul_scalar(low, low, 4, 512);
        for (int32_t member = 0; member < 4; ++member) {
          __bang_add_scalar(mapped + member * 512, pages, member, 512);
          if constexpr (Prefill) {
            __memcpy(
                member_mask + member * 512, valid, sizeof(valid), NRAM2NRAM);
          } else {
            __bang_le_scalar(
                member_mask + member * 512, low, position - member, 512);
            __bang_band(member_mask + member * 512,
                        member_mask + member * 512,
                        valid,
                        512);
          }
        }
        __bang_int322float(mask, member_mask, 2048, 0);
        __bang_transpose(interleaved, mapped, 4, 512);
        __bang_transpose(ordered_mask, mask, 4, 512);
        count = __bang_filter(reinterpret_cast<float*>(slots),
                              reinterpret_cast<float*>(interleaved),
                              ordered_mask,
                              2048);
      }
      if (append_tail && position >= 0) {
        int64_t first = (static_cast<int64_t>(position) + 1) / 4 * 4;
        for (int32_t member = 0; member < 3 && first + member <= position;
             ++member) {
          int64_t logical = first + member;
          if (!Prefill && logical / 16 >= table_width) {
            continue;
          }
          int32_t logical_page =
              logical / 16 < table_width ? logical / 16 : table_width - 1;
          int32_t page = cached_pages <= 8192
                             ? cached_table[logical_page]
                             : table[request * table_width + logical_page];
          if (Prefill || page >= 0) {
            slots[count++] = page * 16 + logical % 16;
          }
        }
      }
      __memcpy(output + static_cast<int64_t>(token) * 2051,
               slots,
               sizeof(slots),
               NRAM2GDRAM);
      lengths[token] = count;
    }
    if constexpr (BalanceTail) {
      if (base < full_rows) {
        base += round_rows;
        if (base >= full_rows) {
          base = full_rows + taskId;
        }
      } else {
        base += taskDim;
      }
    } else {
      base += round_rows;
    }
  }
}
}  // namespace
namespace {
void launch_expand(void* queue,
                   const void* selected,
                   const void* positions,
                   const void* rows,
                   const void* table,
                   void* output,
                   void* lengths,
                   int32_t tokens,
                   int32_t table_width,
                   int32_t append_tail,
                   int32_t batch) {
  cnrtDim3_t grid = {32, 1, 1};
  if (tokens >= 128 && tokens % 128 != 0) {
    expand_kernel<false, 4, true, true>
        <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(selected),
            static_cast<const int32_t*>(positions),
            static_cast<const int64_t*>(rows),
            static_cast<const int32_t*>(table),
            static_cast<int32_t*>(output),
            static_cast<int32_t*>(lengths),
            tokens,
            table_width,
            append_tail != 0,
            batch);
  } else if (tokens >= 128 && tokens <= INT32_MAX - 128) {
    expand_kernel<false, 4, true, false, int32_t>
        <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(selected),
            static_cast<const int32_t*>(positions),
            static_cast<const int64_t*>(rows),
            static_cast<const int32_t*>(table),
            static_cast<int32_t*>(output),
            static_cast<int32_t*>(lengths),
            tokens,
            table_width,
            append_tail != 0,
            batch);
  } else if (tokens >= 128) {
    expand_kernel<false, 4, true>
        <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(selected),
            static_cast<const int32_t*>(positions),
            static_cast<const int64_t*>(rows),
            static_cast<const int32_t*>(table),
            static_cast<int32_t*>(output),
            static_cast<int32_t*>(lengths),
            tokens,
            table_width,
            append_tail != 0,
            batch);
  } else if (tokens > 32) {
    expand_kernel<false, 1, true>
        <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(selected),
            static_cast<const int32_t*>(positions),
            static_cast<const int64_t*>(rows),
            static_cast<const int32_t*>(table),
            static_cast<int32_t*>(output),
            static_cast<int32_t*>(lengths),
            tokens,
            table_width,
            append_tail != 0,
            batch);
  } else {
    expand_kernel<false, 1>
        <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(selected),
            static_cast<const int32_t*>(positions),
            static_cast<const int64_t*>(rows),
            static_cast<const int32_t*>(table),
            static_cast<int32_t*>(output),
            static_cast<int32_t*>(lengths),
            tokens,
            table_width,
            append_tail != 0,
            batch);
  }
}

void launch_prefill_expand(void* queue,
                           const void* selected,
                           const void* positions,
                           const void* rows,
                           const void* table,
                           void* output,
                           void* lengths,
                           int32_t tokens,
                           int32_t table_width,
                           int32_t append_tail,
                           int32_t batch) {
  cnrtDim3_t grid = {32, 1, 1};
  expand_kernel<true>
      <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
          static_cast<const int64_t*>(selected),
          static_cast<const int32_t*>(positions),
          static_cast<const int64_t*>(rows),
          static_cast<const int32_t*>(table),
          static_cast<int32_t*>(output),
          static_cast<int32_t*>(lengths),
          tokens,
          table_width,
          append_tail != 0,
          batch);
}

}  // namespace
extern "C" void kpool_expand(void* queue,
                             const void* selected,
                             const void* positions,
                             const void* rows,
                             const void* table,
                             void* output,
                             void* lengths,
                             int32_t tokens,
                             int32_t table_width,
                             int32_t append_tail) {
  launch_expand(queue,
                selected,
                positions,
                rows,
                table,
                output,
                lengths,
                tokens,
                table_width,
                append_tail,
                INT32_MAX);
}

