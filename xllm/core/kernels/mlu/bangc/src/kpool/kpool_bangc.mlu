extern "C" void kpool_prefill_expand_bounded(void* queue,
                                             const void* selected,
                                             const void* positions,
                                             const void* rows,
                                             const void* table,
                                             void* output,
                                             void* lengths,
                                             int32_t tokens,
                                             int32_t table_width,
                                             int32_t batch,
                                             int32_t append_tail) {
  launch_prefill_expand(queue,
                        selected,
                        positions,
                        rows,
                        table,
                        output,
                        lengths,
                        tokens,
                        table_width,
                        append_tail,
                        batch);
}
// Public rows are explicit metadata: starts alone cannot prove that a
// four-query group shares a row or contains at most four live queries.
// Reuse the row-grouped native implementation so padding and ragged request
// offsets cannot suppress or omit another query. No host metadata read or
// additional device launch is needed.
extern "C" void kpool_score_verify(void* queue,
                                   const void* query,
                                   const void* weights,
                                   const void* cache,
                                   const void* table,
                                   const void* positions,
                                   const void* rows,
                                   const void* starts,
                                   void* output,
                                   int32_t batch,
                                   int32_t tokens,
                                   int32_t capacity,
                                   int32_t table_width,
                                   int32_t cache_blocks,
                                   float scale) {
  kpool_score(queue,
              query,
              weights,
              cache,
              table,
              positions,
              rows,
              output,
              tokens,
              capacity,
              table_width,
              cache_blocks,
              scale);
}

namespace {
// Retain the independently compiled static request layout for a single wave
// with longer per-request spans. The host bounds make its int32 loop safe.
template <typename Index>
__mlu_global__ void rows_static_kernel(const Index* starts,
                                       Index* output,
                                       int32_t batch,
                                       int32_t tokens) {
  __nram__ Index rows[512], cached_starts[129];
  if (batch <= 128) {
    __memcpy(cached_starts, starts, (batch + 1) * sizeof(Index), GDRAM2NRAM);
  }
  for (int32_t request = taskId; request < batch; request += taskDim) {
    int32_t begin = static_cast<int32_t>(batch <= 128 ? cached_starts[request]
                                                      : starts[request]);
    int32_t end =
        request == batch - 1
            ? tokens
            : static_cast<int32_t>(batch <= 128 ? cached_starts[request + 1]
                                                : starts[request + 1]);
    begin = begin < 0 ? 0 : begin;
    end = end > tokens ? tokens : end;
    __bang_write_value(rows, 512, static_cast<Index>(request));
    for (int32_t first = begin; first < end; first += 512) {
      int32_t count = end - first < 512 ? end - first : 512;
      __memcpy(output + first, rows, count * sizeof(Index), NRAM2GDRAM);
    }
  }
  Index first_start = batch <= 128 ? cached_starts[0] : starts[0];
  if (taskId == 0 && first_start > 0) {
    __bang_write_value(rows, 512, static_cast<Index>(-1));
    int32_t end = first_start < tokens ? first_start : tokens;
    for (int32_t first = 0; first < end; first += 512) {
      int32_t count = end - first < 512 ? end - first : 512;
      __memcpy(output + first, rows, count * sizeof(Index), NRAM2GDRAM);
    }
  }
}
template <typename Index>
__mlu_global__ void rows_kernel(const Index* starts,
                                Index* output,
                                int32_t batch,
                                int32_t tokens) {
  __nram__ Index rows[512], cached_starts[129];
  if (batch <= 128) {
    __memcpy(cached_starts, starts, (batch + 1) * sizeof(Index), GDRAM2NRAM);
  }
  for (int64_t request = taskId; request < batch; request += taskDim) {
    int32_t begin = static_cast<int32_t>(batch <= 128 ? cached_starts[request]
                                                      : starts[request]);
    int32_t end =
        request == batch - 1
            ? tokens
            : static_cast<int32_t>(batch <= 128 ? cached_starts[request + 1]
                                                : starts[request + 1]);
    begin = begin < 0 ? 0 : begin;
    end = end > tokens ? tokens : end;
    __bang_write_value(rows, 512, static_cast<Index>(request));
    for (int64_t first = begin; first < end; first += 512) {
      int32_t count = end - first < 512 ? end - first : 512;
      __memcpy(output + first, rows, count * sizeof(Index), NRAM2GDRAM);
    }
  }
  Index first_start = batch <= 128 ? cached_starts[0] : starts[0];
  if (taskId == 0 && first_start > 0) {
    __bang_write_value(rows, 512, static_cast<Index>(-1));
    int32_t end = first_start < tokens ? first_start : tokens;
    for (int64_t first = 0; first < end; first += 512) {
      int32_t count = end - first < 512 ? end - first : 512;
      __memcpy(output + first, rows, count * sizeof(Index), NRAM2GDRAM);
    }
  }
}
// MLU592 scalar integer stores are not a 64-bit sign-extension boundary.
// Encode into a typed 32-bit buffer, then copy bytes; no type-punned lvalue.
template <typename Index>
__mlu_func__ void encode_row_index(int32_t* words,
                                   int32_t offset,
                                   int32_t value) {
  if constexpr (sizeof(Index) == sizeof(int64_t)) {
    words[2 * offset] = value;
    words[2 * offset + 1] = value < 0 ? -1 : 0;
  } else {
    words[offset] = value;
  }
}
template <typename Index, int32_t Tile>
__mlu_global__ void rows_coalesced_kernel(const Index* starts,
                                          Index* output,
                                          int32_t batch,
                                          int32_t tokens) {
  __nram__ Index values[Tile], cached_starts[129], sparse_values[128];
  __nram__ int32_t sparse_words[2 * Tile];
  __memcpy(cached_starts, starts, (batch + 1) * sizeof(Index), GDRAM2NRAM);
  if (batch <= 32 && (batch + 3) / 4 >= 8 && tokens <= batch &&
      cached_starts[batch] <= tokens / 2) {
    // Four neighboring request intervals form one contiguous DMA range.
    // Bounded metadata work avoids long scans over sparse empty requests.
    for (int32_t request_group = taskId * 4; request_group < batch;
         request_group += taskDim * 4) {
      int32_t group_end = request_group + 4 < batch ? request_group + 4 : batch;
      int32_t first = static_cast<int32_t>(cached_starts[request_group]);
      int32_t last = group_end == batch
                         ? tokens
                         : static_cast<int32_t>(cached_starts[group_end]);
      first = first < 0 ? 0 : first;
      last = last > tokens ? tokens : last;
      for (int32_t request = request_group; request < group_end; ++request) {
        int32_t begin = static_cast<int32_t>(cached_starts[request]);
        int32_t end = request == batch - 1
                          ? tokens
                          : static_cast<int32_t>(cached_starts[request + 1]);
        begin = begin < first ? first : begin;
        end = end > last ? last : end;
        if (begin < end) {
          __bang_write_value(sparse_values + begin - first,
                             end - begin,
                             static_cast<Index>(request));
        }
      }
      if (first < last) {
        __memcpy(output + first,
                 sparse_values,
                 (last - first) * sizeof(Index),
                 NRAM2GDRAM);
      }
    }
    if (taskId == 0 && cached_starts[0] > 0) {
      int32_t end = cached_starts[0] < tokens ? cached_starts[0] : tokens;
      __bang_write_value(sparse_values, 128, static_cast<Index>(-1));
      __memcpy(output, sparse_values, end * sizeof(Index), NRAM2GDRAM);
    }
    return;
  }
  for (int64_t base = taskId * Tile; base < tokens; base += taskDim * Tile) {
    int32_t first = static_cast<int32_t>(base > 0 ? base : 0);
    int32_t last =
        static_cast<int32_t>(base + Tile < tokens ? base + Tile : tokens);
    if constexpr (Tile <= 16) {
      if (cached_starts[batch] <= tokens / 2) {
        // Sparse requests make scanning all empty intervals expensive. Resolve
        // each bounded output lane directly; the final request owns padding.
        for (int32_t offset = first; offset < last; ++offset) {
          int32_t request = batch - 1;
          if (offset < cached_starts[batch - 1]) {
            int32_t lower = 0, upper = batch;
            while (lower < upper) {
              int32_t middle = (lower + upper) / 2;
              if (cached_starts[middle] <= offset) {
                lower = middle + 1;
              } else {
                upper = middle;
              }
            }
            request = lower - 1;
          }
          encode_row_index<Index>(sparse_words, offset - first, request);
        }
        __memcpy(output + first,
                 sparse_words,
                 (last - first) * sizeof(Index),
                 NRAM2GDRAM);
        continue;
      }
    }
    __bang_write_value(values, Tile, static_cast<Index>(-1));
    int32_t first_request = 0;
    if (batch > 4) {
      int32_t lower = 0, upper = batch;
      while (lower < upper) {
        int32_t middle = (lower + upper) / 2;
        if (cached_starts[middle] <= first) {
          lower = middle + 1;
        } else {
          upper = middle;
        }
      }
      first_request = lower > 0 ? lower - 1 : 0;
    }
    for (int32_t request = first_request; request < batch; ++request) {
      int32_t begin = static_cast<int32_t>(cached_starts[request]);
      if (begin >= last) {
        break;
      }
      int32_t end = request == batch - 1
                        ? tokens
                        : static_cast<int32_t>(cached_starts[request + 1]);
      begin = begin > first ? begin : first;
      end = end < last ? end : last;
      if (begin < end) {
        __bang_write_value(
            values + begin - first, end - begin, static_cast<Index>(request));
      }
    }
    __memcpy(
        output + first, values, (last - first) * sizeof(Index), NRAM2GDRAM);
  }
}

}  // namespace
extern "C" void kpool_rows(void* queue,
                           const void* starts,
                           void* output,
                           int32_t batch,
                           int32_t tokens,
                           int32_t bits) {
  if (batch <= 32 && tokens > batch * 4 && tokens <= batch * 128 &&
      tokens / 128 + (tokens % 128 != 0) < batch) {
    cnrtDim3_t static_grid = {32, 1, 1};
    if (bits == 32) {
      rows_static_kernel<int32_t>
          <<<static_grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const int32_t*>(starts),
              static_cast<int32_t*>(output),
              batch,
              tokens);
    } else {
      rows_static_kernel<int64_t>
          <<<static_grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const int64_t*>(starts),
              static_cast<int64_t*>(output),
              batch,
              tokens);
    }
    return;
  }
  if (batch <= 128 && tokens / 128 + (tokens % 128 != 0) <= batch) {
    const bool dense_requests = tokens <= batch * 4;
    int32_t tile = dense_requests ? (tokens <= 256 ? 8 : 16) : 128;
    if (tokens <= batch && tokens <= 32) {
      tile = 4;
    }
    int32_t tasks = tokens / tile + (tokens % tile != 0);
    if (batch <= 32 && tokens <= batch) {
      int32_t request_tasks = batch / 4 + (batch % 4 != 0);
      tasks = tasks > request_tasks ? tasks : request_tasks;
    }
    cnrtDim3_t tiled_grid = {
        static_cast<uint32_t>(tasks < 32 ? tasks : 32), 1, 1};
    if (bits == 32) {
      if (tile == 4) {
        rows_coalesced_kernel<int32_t, 4><<<tiled_grid,
                                            cnrtFuncTypeBlock,
                                            static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int32_t*>(starts),
            static_cast<int32_t*>(output),
            batch,
            tokens);
      } else if (tile == 8) {
        rows_coalesced_kernel<int32_t, 8><<<tiled_grid,
                                            cnrtFuncTypeBlock,
                                            static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int32_t*>(starts),
            static_cast<int32_t*>(output),
            batch,
            tokens);
      } else if (dense_requests) {
        rows_coalesced_kernel<int32_t, 16><<<tiled_grid,
                                             cnrtFuncTypeBlock,
                                             static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int32_t*>(starts),
            static_cast<int32_t*>(output),
            batch,
            tokens);
      } else {
        rows_coalesced_kernel<int32_t, 128>
            <<<tiled_grid,
               cnrtFuncTypeBlock,
               static_cast<cnrtQueue_t>(queue)>>>(
                static_cast<const int32_t*>(starts),
                static_cast<int32_t*>(output),
                batch,
                tokens);
      }
    } else {
      if (tile == 4) {
        rows_coalesced_kernel<int64_t, 4><<<tiled_grid,
                                            cnrtFuncTypeBlock,
                                            static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(starts),
            static_cast<int64_t*>(output),
            batch,
            tokens);
      } else if (tile == 8) {
        rows_coalesced_kernel<int64_t, 8><<<tiled_grid,
                                            cnrtFuncTypeBlock,
                                            static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(starts),
            static_cast<int64_t*>(output),
            batch,
            tokens);
      } else if (dense_requests) {
        rows_coalesced_kernel<int64_t, 16><<<tiled_grid,
                                             cnrtFuncTypeBlock,
                                             static_cast<cnrtQueue_t>(queue)>>>(
            static_cast<const int64_t*>(starts),
            static_cast<int64_t*>(output),
            batch,
            tokens);
      } else {
        rows_coalesced_kernel<int64_t, 128>
            <<<tiled_grid,
               cnrtFuncTypeBlock,
               static_cast<cnrtQueue_t>(queue)>>>(
                static_cast<const int64_t*>(starts),
                static_cast<int64_t*>(output),
                batch,
                tokens);
      }
    }
    return;
  }
  cnrtDim3_t grid = {static_cast<uint32_t>(batch < 32 ? batch : 32), 1, 1};
  if (bits == 32) {
    rows_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const int32_t*>(starts),
        static_cast<int32_t*>(output),
        batch,
        tokens);
  } else {
    rows_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const int64_t*>(starts),
        static_cast<int64_t*>(output),
        batch,
        tokens);
  }
}

namespace {
template <typename Id, int32_t LocalSlots>
__mlu_global__ void stash_cooperative_kernel(const bfloat16_t* key,
                                             const bfloat16_t* gate,
                                             bfloat16_t* tail,
                                             const Id* ids,
                                             const Id* read_ids,
                                             const int32_t* positions,
                                             const int64_t* starts,
                                             int32_t batch,
                                             int32_t ring_size,
                                             bool inherit) {
  if (__is_mpu()) {
    return;
  }
  __nram__ bfloat16_t shadow_storage[2 * LocalSlots * 128];
  __nram__ int32_t final_positions[128];
  for (int32_t req = taskId; req < batch; req += taskDim) {
    bfloat16_t* shadow = shadow_storage + static_cast<int64_t>(req / taskDim) *
                                              2 * ring_size * 128;
    int64_t state = read_state_id(ids, req);
    if (state <= 0) {
      continue;
    }
    int64_t start = starts[req], end = starts[req + 1];
    while (end > start && positions[end - 1] < 0) {
      --end;
    }
    int32_t last = end > start ? positions[end - 1] : -1;
    if (ring_size <= 128) {
      int64_t source_state = inherit ? read_state_id(read_ids, req) : state;
      bool all_current = end - start >= ring_size;
      if (all_current) {
        __memcpy(final_positions,
                 positions + end - ring_size,
                 ring_size * sizeof(int32_t),
                 GDRAM2NRAM);
        for (int32_t slot = 0; slot < ring_size; ++slot) {
          if (final_positions[slot] < 0) {
            all_current = false;
            break;
          }
        }
      }
      if (all_current) {
        int32_t first_count = last % ring_size + 1;
        int32_t second_count = ring_size - first_count;
        __memcpy_async(shadow,
                       key + (end - first_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        __memcpy_async(shadow + ring_size * 128,
                       gate + (end - first_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        if (second_count > 0) {
          __memcpy_async(shadow + first_count * 128,
                         key + (end - ring_size) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
          __memcpy_async(shadow + (ring_size + first_count) * 128,
                         gate + (end - ring_size) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
        }
        __sync_io();

        continue;
      }
      if (!all_current && source_state > 0) {
        __memcpy(shadow,
                 tail + source_state * 2 * ring_size * 128,
                 2 * ring_size * 256,
                 GDRAM2NRAM);
      } else if (!all_current) {
        __bang_write_value(
            shadow, 2 * ring_size * 128, static_cast<bfloat16_t>(0));
        __sync_compute();
      }
      int32_t current_count = end - start < ring_size ? end - start : ring_size;
      bool contiguous_current = current_count > 0;
      if (current_count > 1) {
        __memcpy(final_positions,
                 positions + end - current_count,
                 current_count * sizeof(int32_t),
                 GDRAM2NRAM);
        for (int32_t slot = 0; slot < current_count; ++slot) {
          if (final_positions[slot] < 0) {
            contiguous_current = false;
          }
        }
      }
      if (contiguous_current) {
        int32_t first_slot =
            ((last - current_count + 1) % ring_size + ring_size) % ring_size;
        int32_t first_count = ring_size - first_slot < current_count
                                  ? ring_size - first_slot
                                  : current_count;
        int32_t second_count = current_count - first_count;
        __memcpy_async(shadow + first_slot * 128,
                       key + (end - current_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        __memcpy_async(shadow + (ring_size + first_slot) * 128,
                       gate + (end - current_count) * 128,
                       first_count * 256,
                       GDRAM2NRAM);
        if (second_count > 0) {
          __memcpy_async(shadow,
                         key + (end - second_count) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
          __memcpy_async(shadow + ring_size * 128,
                         gate + (end - second_count) * 128,
                         second_count * 256,
                         GDRAM2NRAM);
        }
        __sync_io();

        continue;
      }
      int32_t last_ring = ((last % ring_size) + ring_size) % ring_size;
      for (int32_t r = 0; r < ring_size;) {
        int64_t source = end - 1 - (last_ring - r + ring_size) % ring_size;
        bool current =
            end > start && source >= start &&
            (current_count > 1 ? final_positions[source - (end - current_count)]
                               : positions[source]) >= 0;
        if (!current) {
          ++r;
          continue;
        }
        int32_t run = 1;
        while (r + run < ring_size) {
          int64_t next =
              end - 1 - (last_ring - r - run + ring_size) % ring_size;
          if (next != source + run || next < start ||
              (current_count > 1 ? final_positions[next - (end - current_count)]
                                 : positions[next]) < 0) {
            break;
          }
          ++run;
        }
        __memcpy_async(
            shadow + r * 128, key + source * 128, run * 256, GDRAM2NRAM);
        __memcpy_async(shadow + (ring_size + r) * 128,
                       gate + source * 128,
                       run * 256,
                       GDRAM2NRAM);
        r += run;
      }
      __sync_io();

      continue;
    }
  }
  __sync();
  if (taskDim > 1) {
    __sync_all_ipu();
  }
  // All current inputs and original inherited sources are now private.
  for (int32_t req = taskId; req < batch; req += taskDim) {
    int64_t state = read_state_id(ids, req);
    if (state <= 0) {
      continue;
    }
    bfloat16_t* shadow = shadow_storage + static_cast<int64_t>(req / taskDim) *
                                              2 * ring_size * 128;
    __memcpy_async(tail + state * 2 * ring_size * 128,
                   shadow,
                   2 * ring_size * 256,
                   NRAM2GDRAM);
  }
  __sync_io();
}

template <typename Id, bool Workspace = false>
__mlu_global__ void stash_sliced_kernel(const bfloat16_t* key,
                                        const bfloat16_t* gate,
                                        bfloat16_t* tail,
                                        const Id* ids,
                                        const Id* read_ids,
                                        const int32_t* positions,
                                        const int64_t* starts,
                                        int32_t batch,
                                        int32_t ring_size,
                                        bfloat16_t* workspace = nullptr) {
  if (__is_mpu()) {
    return;
  }
  // Host bounds guarantee <=32 slices per IPU. Each slice owns <=16 slots.
  __nram__ bfloat16_t key_slices[(Workspace ? 16 : 512) * 128];
  __nram__ bfloat16_t gate_slices[(Workspace ? 16 : 512) * 128];
  __nram__ int32_t local_positions[16];
  int32_t slices = ring_size / 16 + (ring_size % 16 != 0);
  int64_t work_count = static_cast<int64_t>(batch) * slices;
  for (int64_t work = taskId; work < work_count; work += taskDim) {
    int64_t request = work / slices;
    int64_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    int32_t first = (work % slices) * 16;
    int32_t count = ring_size - first < 16 ? ring_size - first : 16;
    int32_t local_first = Workspace ? 0 : (work / taskDim) * 16;
    int64_t begin = starts[request], end = starts[request + 1];
    while (end > begin && positions[end - 1] < 0) {
      --end;
    }
    int32_t last = end > begin ? positions[end - 1] : -1;
    int64_t last_ring =
        (static_cast<int64_t>(last) % ring_size + ring_size) % ring_size;
    int64_t source_state = read_state_id(read_ids, request);
    // At most two contiguous position spans describe this ring slice. Load
    // their masks once instead of issuing one global scalar read per slot.
    __bang_write_value(local_positions, 16, -1);
    __sync_compute();
    if (end > begin) {
      for (int32_t offset = 0; offset < count;) {
        int32_t ring = first + offset;
        int64_t source = end - 1 - (last_ring - ring + ring_size) % ring_size;
        int32_t run =
            ring <= last_ring ? last_ring - ring + 1 : ring_size - ring;
        run = run < count - offset ? run : count - offset;
        int64_t skip = source < begin ? begin - source : 0;
        if (skip < run) {
          __memcpy_async(local_positions + offset + skip,
                         positions + source + skip,
                         (run - skip) * sizeof(int32_t),
                         GDRAM2NRAM);
        }
        offset += run;
      }
    }
    __sync_io();
    for (int32_t offset = 0; offset < count;) {
      int32_t ring = first + offset;
      int64_t source = end - 1 - (last_ring - ring + ring_size) % ring_size;
      bool current = local_positions[offset] >= 0;
      int32_t run = 1;
      while (offset + run < count) {
        int32_t next_ring = ring + run;
        int64_t next_source =
            end - 1 - (last_ring - next_ring + ring_size) % ring_size;
        bool next_current = local_positions[offset + run] >= 0;
        if (next_current != current ||
            (current && next_source != source + run)) {
          break;
        }
        ++run;
      }
      bfloat16_t* key_output = key_slices + (local_first + offset) * 128;
      bfloat16_t* gate_output = gate_slices + (local_first + offset) * 128;
      if (current) {
        __memcpy_async(key_output, key + source * 128, run * 256, GDRAM2NRAM);
        __memcpy_async(gate_output, gate + source * 128, run * 256, GDRAM2NRAM);
      } else if (source_state > 0) {
        __memcpy_async(key_output,
                       tail + (source_state * 2 * ring_size + ring) * 128,
                       run * 256,
                       GDRAM2NRAM);
        __memcpy_async(
            gate_output,
            tail + (source_state * 2 * ring_size + ring_size + ring) * 128,
            run * 256,
            GDRAM2NRAM);
      } else {
        __bang_write_value(key_output, run * 128, static_cast<bfloat16_t>(0));
        __bang_write_value(gate_output, run * 128, static_cast<bfloat16_t>(0));
      }
      offset += run;
    }
    if constexpr (Workspace) {
      __sync();
      __memcpy_async(workspace + (request * 2 * ring_size + first) * 128,
                     key_slices,
                     count * 256,
                     NRAM2GDRAM);
      __memcpy_async(
          workspace + (request * 2 * ring_size + ring_size + first) * 128,
          gate_slices,
          count * 256,
          NRAM2GDRAM);
      __sync_io();
    }
  }
  if constexpr (Workspace) {
    return;
  }
  __sync();
  // Host launches exactly one Block or Union task spanning the whole grid.
  // All its IPUs reach this barrier; MPUs return without taking an IPU barrier.
  // No destination is written until every original-tail read has completed.
  if (taskDim > 1) {
    __sync_all_ipu();
  }
  for (int64_t work = taskId; work < work_count; work += taskDim) {
    int64_t request = work / slices;
    int64_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    int32_t first = (work % slices) * 16;
    int32_t count = ring_size - first < 16 ? ring_size - first : 16;
    int32_t local_first = (work / taskDim) * 16;
    __memcpy_async(tail + (state * 2 * ring_size + first) * 128,
                   key_slices + local_first * 128,
                   count * 256,
                   NRAM2GDRAM);
    __memcpy_async(tail + (state * 2 * ring_size + ring_size + first) * 128,
                   gate_slices + local_first * 128,
                   count * 256,
                   NRAM2GDRAM);
  }
  __sync_io();
}
}  // namespace
extern "C" void kpool_stash(void* queue,
                            const void* key,
                            const void* gate,
                            void* tail,
                            const void* ids,
                            const void* read_ids,
                            const void* positions,
                            const void* starts,
                            int32_t batch,
                            int32_t ring_size,
                            int32_t bits) {
  int64_t work_count =
      static_cast<int64_t>(batch) *
      (static_cast<int64_t>(ring_size) / 16 + (ring_size % 16 != 0));
  if (batch > 0 && ring_size > 0 && work_count <= 1024) {
    int64_t launch_work = ring_size <= 64 && batch <= 128 ? batch : work_count;
    uint32_t width = launch_work <= 1    ? 1
                     : launch_work <= 4  ? 4
                     : launch_work <= 8  ? 8
                     : launch_work <= 16 ? 16
                                         : 32;
    cnrtFunctionType_t kind = width == 1    ? cnrtFuncTypeBlock
                              : width == 4  ? cnrtFuncTypeUnion1
                              : width == 8  ? cnrtFuncTypeUnion2
                              : width == 16 ? cnrtFuncTypeUnion4
                                            : cnrtFuncTypeUnion8;
    cnrtDim3_t balanced_grid = {width, 1, 1};
    if (ring_size <= 64 && batch <= 128) {
      if (bits == 64) {
        if (batch <= 32) {
          stash_cooperative_kernel<int64_t, 64>
              <<<balanced_grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
                  static_cast<const bfloat16_t*>(key),
                  static_cast<const bfloat16_t*>(gate),
                  static_cast<bfloat16_t*>(tail),
                  static_cast<const int64_t*>(ids),
                  static_cast<const int64_t*>(read_ids),
                  static_cast<const int32_t*>(positions),
                  static_cast<const int64_t*>(starts),
                  batch,
                  ring_size,
                  true);
        } else {
          stash_cooperative_kernel<int64_t, 256>
              <<<balanced_grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
                  static_cast<const bfloat16_t*>(key),
                  static_cast<const bfloat16_t*>(gate),
                  static_cast<bfloat16_t*>(tail),
                  static_cast<const int64_t*>(ids),
                  static_cast<const int64_t*>(read_ids),
                  static_cast<const int32_t*>(positions),
                  static_cast<const int64_t*>(starts),
                  batch,
                  ring_size,
                  true);
        }
      } else {
        if (batch <= 32) {
          stash_cooperative_kernel<int32_t, 64>
              <<<balanced_grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
                  static_cast<const bfloat16_t*>(key),
                  static_cast<const bfloat16_t*>(gate),
                  static_cast<bfloat16_t*>(tail),
                  static_cast<const int32_t*>(ids),
                  static_cast<const int32_t*>(read_ids),
                  static_cast<const int32_t*>(positions),
                  static_cast<const int64_t*>(starts),
                  batch,
                  ring_size,
                  true);
        } else {
          stash_cooperative_kernel<int32_t, 256>
              <<<balanced_grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
                  static_cast<const bfloat16_t*>(key),
                  static_cast<const bfloat16_t*>(gate),
                  static_cast<bfloat16_t*>(tail),
                  static_cast<const int32_t*>(ids),
                  static_cast<const int32_t*>(read_ids),
                  static_cast<const int32_t*>(positions),
                  static_cast<const int64_t*>(starts),
                  batch,
                  ring_size,
                  true);
        }
      }
      return;
    }
    if (bits == 64) {
      stash_sliced_kernel<int64_t>
          <<<balanced_grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(key),
              static_cast<const bfloat16_t*>(gate),
              static_cast<bfloat16_t*>(tail),
              static_cast<const int64_t*>(ids),
              static_cast<const int64_t*>(read_ids),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(starts),
              batch,
              ring_size);
    } else {
      stash_sliced_kernel<int32_t>
          <<<balanced_grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
              static_cast<const bfloat16_t*>(key),
              static_cast<const bfloat16_t*>(gate),
              static_cast<bfloat16_t*>(tail),
              static_cast<const int32_t*>(ids),
              static_cast<const int32_t*>(read_ids),
              static_cast<const int32_t*>(positions),
              static_cast<const int64_t*>(starts),
              batch,
              ring_size);
    }
    return;
  }
  cnrtDim3_t grid = {32, 1, 1};
  if (bits == 32) {
    stash_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const bfloat16_t*>(key),
        static_cast<const bfloat16_t*>(gate),
        static_cast<bfloat16_t*>(tail),
        static_cast<const int32_t*>(ids),
        static_cast<const int32_t*>(read_ids),
        static_cast<const int32_t*>(positions),
        static_cast<const int64_t*>(starts),
        batch,
        ring_size,
        true);
  } else {
    stash_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const bfloat16_t*>(key),
        static_cast<const bfloat16_t*>(gate),
        static_cast<bfloat16_t*>(tail),
        static_cast<const int64_t*>(ids),
        static_cast<const int64_t*>(read_ids),
        static_cast<const int32_t*>(positions),
        static_cast<const int64_t*>(starts),
        batch,
        ring_size,
        true);
  }
}

namespace {
template <typename Id>
__mlu_func__ void update_pools_parallel(const bfloat16_t* key,
                                        const bfloat16_t* gate,
                                        const float* ape,
                                        const float* matrix,
                                        bfloat16_t* cache,
                                        const bfloat16_t* tail,
                                        const Id* ids,
                                        const Id* read_ids,
                                        const int32_t* table,
                                        const int32_t* positions,
                                        const int64_t* starts,
                                        int32_t batch,
                                        int32_t tokens,
                                        int32_t table_width,
                                        int32_t ring_size,
                                        bool inherit) {
  __nram__ bfloat16_t keys[512], gates[512], out[128];
  __nram__ int32_t member_positions[3];
  __nram__ float local_matrix[128 * 128], local_bias[512];
  bool matrix_loaded = false;
  for (int64_t group = taskId; group * 4 < tokens; group += taskDim) {
    for (int32_t offset = 0; offset < 4 && group * 4 + offset < tokens;
         ++offset) {
      int64_t token = group * 4 + offset;
      int32_t position = positions[token];
      if (position < 0 || position % 4 != 3 || position / 16 >= table_width) {
        continue;
      }
      int32_t lo = 0, hi = batch;
      while (lo < hi) {
        int32_t middle = lo + (hi - lo) / 2;
        if (starts[middle] <= token) {
          lo = middle + 1;
        } else {
          hi = middle;
        }
      }
      int32_t request = lo - 1;
      int64_t state = read_state_id(ids, request);
      if (state <= 0) {
        continue;
      }
      int32_t block =
          table[static_cast<int64_t>(request) * table_width + position / 16];
      if (block < 0) {
        continue;
      }
      if (!matrix_loaded) {
        __memcpy_async(local_matrix, matrix, sizeof(local_matrix), GDRAM2NRAM);
        __memcpy_async(local_bias, ape, sizeof(local_bias), GDRAM2NRAM);
        __sync_io();
        matrix_loaded = true;
      }
      int64_t begin = starts[request];
      int64_t source_state = inherit ? read_state_id(read_ids, request) : state;
      bool all_current = token - 3 >= begin;
      if (all_current) {
        __memcpy(member_positions,
                 positions + token - 3,
                 sizeof(member_positions),
                 GDRAM2NRAM);
        for (int32_t member = 0; member < 3; ++member) {
          if (member_positions[member] < 0) {
            all_current = false;
          }
        }
      }
      if (all_current) {
        __memcpy_async(keys, key + (token - 3) * 128, sizeof(keys), GDRAM2NRAM);
        __memcpy_async(
            gates, gate + (token - 3) * 128, sizeof(gates), GDRAM2NRAM);
      } else {
        for (int32_t member = 0; member < 4; ++member) {
          int64_t source = token - 3 + member;
          bool current =
              member == 3 || (source >= begin && positions[source] >= 0);
          if (!current) {
            // The sequential update has already written every earlier valid
            // token into its ring. Reconstruct exactly that slot without
            // changing tail.
            int32_t ring = (position - 3 + member) % ring_size;
            source = token - 1;
            while (source >= begin) {
              int32_t prior = positions[source];
              if (prior >= 0 && prior % ring_size == ring) {
                break;
              }
              --source;
            }
            current = source >= begin;
            if (!current && source_state > 0) {
              __memcpy_async(keys + member * 128,
                             tail + (source_state * 2 * ring_size + ring) * 128,
                             256,
                             GDRAM2NRAM);
              __memcpy_async(
                  gates + member * 128,
                  tail +
                      (source_state * 2 * ring_size + ring_size + ring) * 128,
                  256,
                  GDRAM2NRAM);
            } else if (!current) {
              __bang_write_value(
                  keys + member * 128, 128, static_cast<bfloat16_t>(0));
              __bang_write_value(
                  gates + member * 128, 128, static_cast<bfloat16_t>(0));
            }
          }
          if (current) {
            __memcpy_async(
                keys + member * 128, key + source * 128, 256, GDRAM2NRAM);
            __memcpy_async(
                gates + member * 128, gate + source * 128, 256, GDRAM2NRAM);
          }
        }
      }
      __sync_io();
      pool_one(keys,
               gates,
               local_bias,
               local_matrix,
               tail,
               3,
               0,
               position,
               state,
               positions,
               ring_size,
               out,
               keys + 384,
               gates + 384,
               false,
               true,
               true,
               false,
               true);
      __memcpy(
          cache + (static_cast<int64_t>(block) * 4 + position / 4 % 4) * 128,
          out,
          256,
          NRAM2GDRAM);
      // pool_one reads the local four-token input on Compute. Its next IO
      // writer must wait, even when the next token belongs to a missing cache
      // page.
      __sync_compute();
    }
  }
}

template <typename Id>
__mlu_func__ void prepare_update_tail_parallel(const bfloat16_t* key,
                                               const bfloat16_t* gate,
                                               const bfloat16_t* tail,
                                               bfloat16_t* workspace,
                                               const Id* ids,
                                               const Id* read_ids,
                                               const int32_t* positions,
                                               const int64_t* starts,
                                               int32_t batch,
                                               int32_t ring_size,
                                               bool inherit) {
  __nram__ bfloat16_t key_slot[128], gate_slot[128];
  int64_t total = static_cast<int64_t>(batch) * ring_size;
  for (int64_t work = taskId; work < total; work += taskDim) {
    int64_t request = work / ring_size;
    int32_t ring = work % ring_size;
    int64_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    int64_t begin = starts[request];
    int64_t source = starts[request + 1] - 1;
    while (source >= begin) {
      int32_t position = positions[source];
      if (position >= 0 && position % ring_size == ring) {
        break;
      }
      --source;
    }
    if (source >= begin) {
      __memcpy_async(key_slot, key + source * 128, 256, GDRAM2NRAM);
      __memcpy_async(gate_slot, gate + source * 128, 256, GDRAM2NRAM);
    } else {
      int64_t source_state = inherit ? read_state_id(read_ids, request) : state;
      if (source_state > 0) {
        __memcpy_async(key_slot,
                       tail + (source_state * 2 * ring_size + ring) * 128,
                       256,
                       GDRAM2NRAM);
        __memcpy_async(
            gate_slot,
            tail + (source_state * 2 * ring_size + ring_size + ring) * 128,
            256,
            GDRAM2NRAM);
      } else {
        __bang_write_value(key_slot, 128, static_cast<bfloat16_t>(0));
        __bang_write_value(gate_slot, 128, static_cast<bfloat16_t>(0));
        __sync_compute();
      }
    }
    __sync_io();
    __memcpy_async(workspace + (request * 2 * ring_size + ring) * 128,
                   key_slot,
                   256,
                   NRAM2GDRAM);
    __memcpy_async(
        workspace + (request * 2 * ring_size + ring_size + ring) * 128,
        gate_slot,
        256,
        NRAM2GDRAM);
    __sync_io();
  }
}

template <typename Id>
__mlu_global__ void prepare_update_parallel_kernel(const bfloat16_t* key,
                                                   const bfloat16_t* gate,
                                                   const float* ape,
                                                   const float* matrix,
                                                   bfloat16_t* cache,
                                                   const bfloat16_t* tail,
                                                   const Id* ids,
                                                   const Id* read_ids,
                                                   const int32_t* table,
                                                   const int32_t* positions,
                                                   const int64_t* starts,
                                                   bfloat16_t* workspace,
                                                   int32_t batch,
                                                   int32_t tokens,
                                                   int32_t table_width,
                                                   int32_t ring_size,
                                                   bool inherit) {
  // Both computations read the original tail and own disjoint outputs. No
  // destination tail is modified until this complete kernel has finished.
  update_pools_parallel(key,
                        gate,
                        ape,
                        matrix,
                        cache,
                        tail,
                        ids,
                        read_ids,
                        table,
                        positions,
                        starts,
                        batch,
                        tokens,
                        table_width,
                        ring_size,
                        inherit);
  prepare_update_tail_parallel(key,
                               gate,
                               tail,
                               workspace,
                               ids,
                               read_ids,
                               positions,
                               starts,
                               batch,
                               ring_size,
                               inherit);
}

template <typename Id>
__mlu_global__ void scatter_update_tail_kernel(const bfloat16_t* workspace,
                                               bfloat16_t* tail,
                                               const Id* ids,
                                               int32_t batch,
                                               int32_t ring_size) {
  __nram__ bfloat16_t key_slot[128], gate_slot[128];
  int64_t total = static_cast<int64_t>(batch) * ring_size;
  for (int64_t work = taskId; work < total; work += taskDim) {
    int64_t request = work / ring_size;
    int32_t ring = work % ring_size;
    int64_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    __memcpy_async(key_slot,
                   workspace + (request * 2 * ring_size + ring) * 128,
                   256,
                   GDRAM2NRAM);
    __memcpy_async(
        gate_slot,
        workspace + (request * 2 * ring_size + ring_size + ring) * 128,
        256,
        GDRAM2NRAM);
    __sync_io();
    __memcpy_async(
        tail + (state * 2 * ring_size + ring) * 128, key_slot, 256, NRAM2GDRAM);
    __memcpy_async(tail + (state * 2 * ring_size + ring_size + ring) * 128,
                   gate_slot,
                   256,
                   NRAM2GDRAM);
    __sync_io();
  }
}

template <typename Id>
__mlu_global__ void scatter_stash_slices_kernel(const bfloat16_t* workspace,
                                                bfloat16_t* tail,
                                                const Id* ids,
                                                int32_t batch,
                                                int32_t ring_size) {
  __nram__ bfloat16_t keys[16 * 128], gates[16 * 128];
  int64_t slices = static_cast<int64_t>(ring_size) / 16 + (ring_size % 16 != 0);
  int64_t total = static_cast<int64_t>(batch) * slices;
  for (int64_t work = taskId; work < total; work += taskDim) {
    int64_t request = work / slices;
    int64_t state = read_state_id(ids, request);
    if (state <= 0) {
      continue;
    }
    int32_t first = (work % slices) * 16;
    int32_t count = ring_size - first < 16 ? ring_size - first : 16;
    __memcpy_async(keys,
                   workspace + (request * 2 * ring_size + first) * 128,
                   count * 256,
                   GDRAM2NRAM);
    __memcpy_async(
        gates,
        workspace + (request * 2 * ring_size + ring_size + first) * 128,
        count * 256,
        GDRAM2NRAM);
    __sync_io();
    __memcpy_async(tail + (state * 2 * ring_size + first) * 128,
                   keys,
                   count * 256,
                   NRAM2GDRAM);
    __memcpy_async(tail + (state * 2 * ring_size + ring_size + first) * 128,
                   gates,
                   count * 256,
                   NRAM2GDRAM);
    __sync_io();
  }
}

template <typename Id>
void stash_with_workspace(void* queue,
                          const void* key,
                          const void* gate,
                          void* tail,
                          const void* ids,
                          const void* read_ids,
                          const void* positions,
                          const void* starts,
                          void* workspace,
                          int32_t batch,
                          int32_t ring_size,
                          int32_t bits) {
  int64_t work_count =
      static_cast<int64_t>(batch) *
      (static_cast<int64_t>(ring_size) / 16 + (ring_size % 16 != 0));
  if (work_count <= 1024) {
    kpool_stash(queue,
                key,
                gate,
                tail,
                ids,
                read_ids,
                positions,
                starts,
                batch,
                ring_size,
                bits);
    return;
  }
  cnrtDim3_t grid = {32, 1, 1};
  stash_sliced_kernel<Id, true>
      <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
          static_cast<const bfloat16_t*>(key),
          static_cast<const bfloat16_t*>(gate),
          static_cast<bfloat16_t*>(tail),
          static_cast<const Id*>(ids),
          static_cast<const Id*>(read_ids),
          static_cast<const int32_t*>(positions),
          static_cast<const int64_t*>(starts),
          batch,
          ring_size,
          static_cast<bfloat16_t*>(workspace));
  // The complete prepare launch reads all original sources before any scatter.
  scatter_stash_slices_kernel<Id>
      <<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
          static_cast<const bfloat16_t*>(workspace),
          static_cast<bfloat16_t*>(tail),
          static_cast<const Id*>(ids),
          batch,
          ring_size);
}

template <typename Id>
__mlu_global__ void snapshot_update_sources_kernel(const bfloat16_t* tail,
                                                   const Id* ids,
                                                   const Id* read_ids,
                                                   bfloat16_t* workspace,
                                                   int32_t batch,
                                                   int32_t ring_size) {
  __nram__ bfloat16_t snapshot[2 * 64 * 128];
  for (int64_t request = taskId; request < batch; request += taskDim) {
    if (read_state_id(ids, request) <= 0) {
      continue;
    }
    int64_t source = read_state_id(read_ids, request);
    if (source > 0) {
      __memcpy(snapshot,
               tail + source * 2 * ring_size * 128,
               2 * ring_size * 256,
               GDRAM2NRAM);
    } else {
      __bang_write_value(
          snapshot, 2 * ring_size * 128, static_cast<bfloat16_t>(0));
      __sync_compute();
    }
    __memcpy(workspace + request * 2 * ring_size * 128,
             snapshot,
             2 * ring_size * 256,
             NRAM2GDRAM);
  }
}

// Keep the one-pool specialization free of coefficient-cache storage and
// descriptors. The dispatch depends only on public tensor shapes.
template <typename Id,
          bool Cooperative,
          bool Snapshot,
          int32_t LocalSlots,
          bool CacheCoefficients>
void launch_chronological_update(void* queue,
                                 cnrtDim3_t grid,
                                 cnrtFunctionType_t kind,
                                 const void* key,
                                 const void* gate,
                                 const void* ape,
                                 const void* matrix,
                                 void* cache,
                                 void* tail,
                                 const void* ids,
                                 const void* read_ids,
                                 const void* table,
                                 const void* positions,
                                 const void* starts,
                                 const void* snapshot,
                                 int32_t batch,
                                 int32_t table_width,
                                 int32_t ring_size,
                                 bool inherit) {
  update_kernel<Id, Cooperative, Snapshot, LocalSlots, CacheCoefficients>
      <<<grid, kind, static_cast<cnrtQueue_t>(queue)>>>(
          static_cast<const bfloat16_t*>(key),
          static_cast<const bfloat16_t*>(gate),
          static_cast<const float*>(ape),
          static_cast<const float*>(matrix),
          static_cast<bfloat16_t*>(cache),
          static_cast<bfloat16_t*>(tail),
          static_cast<const Id*>(ids),
          static_cast<const Id*>(read_ids),
          static_cast<const int32_t*>(table),
          static_cast<const int32_t*>(positions),
          static_cast<const int64_t*>(starts),
          batch,
          table_width,
          ring_size,
          inherit,
          static_cast<const bfloat16_t*>(snapshot));
}

template <typename Id>
void update_with_workspace(void* queue,
                           const void* key,
                           const void* gate,
                           const void* ape,
                           const void* matrix,
                           void* cache,
                           void* tail,
                           const void* ids,
                           const void* read_ids,
                           const void* table,
                           const void* positions,
                           const void* starts,
                           void* workspace,
                           int32_t batch,
                           int32_t table_width,
                           int32_t ring_size,
                           int32_t inherit,
                           int32_t tokens) {
  cnrtDim3_t grid = {32, 1, 1};
  bool cache_coefficients = batch > 32 || static_cast<int64_t>(tokens) >
                                              static_cast<int64_t>(batch) * 4;
  bool parallel = tokens >= 128 && static_cast<int64_t>(tokens) >
                                       static_cast<int64_t>(batch) * 32;
  bool distinct_sources = inherit != 0 && read_ids != ids;
  bool saturated_short = batch >= 8 && static_cast<int64_t>(tokens) <=
                                           static_cast<int64_t>(batch) * 64;
  int64_t owned_slots = ((static_cast<int64_t>(batch) + 31) / 32) * ring_size;
  if (distinct_sources && batch > 1 && ring_size <= 64 &&
      (!parallel || saturated_short) && owned_slots <= 256) {
    grid.x = batch <= 4 ? 4 : batch <= 8 ? 8 : batch <= 16 ? 16 : 32;
    cnrtFunctionType_t kind = grid.x == 4    ? cnrtFuncTypeUnion1
                              : grid.x == 8  ? cnrtFuncTypeUnion2
                              : grid.x == 16 ? cnrtFuncTypeUnion4
                                             : cnrtFuncTypeUnion8;
    if (owned_slots <= 64) {
      const auto launch =
          cache_coefficients
              ? launch_chronological_update<Id, true, false, 64, true>
              : launch_chronological_update<Id, true, false, 64, false>;
      launch(queue,
             grid,
             kind,
             key,
             gate,
             ape,
             matrix,
             cache,
             tail,
             ids,
             read_ids,
             table,
             positions,
             starts,
             nullptr,
             batch,
             table_width,
             ring_size,
             /*inherit=*/true);
    } else {
      const auto launch =
          cache_coefficients
              ? launch_chronological_update<Id, true, false, 256, true>
              : launch_chronological_update<Id, true, false, 256, false>;
      launch(queue,
             grid,
             kind,
             key,
             gate,
             ape,
             matrix,
             cache,
             tail,
             ids,
             read_ids,
             table,
             positions,
             starts,
             nullptr,
             batch,
             table_width,
             ring_size,
             /*inherit=*/true);
    }
    return;
  }
  if (!parallel && (!distinct_sources || (batch == 1 && ring_size <= 64))) {
    grid.x = static_cast<uint32_t>(batch < 32 ? batch : 32);
    const auto launch =
        cache_coefficients
            ? launch_chronological_update<Id, false, false, 64, true>
            : launch_chronological_update<Id, false, false, 64, false>;
    launch(queue,
           grid,
           cnrtFuncTypeBlock,
           key,
           gate,
           ape,
           matrix,
           cache,
           tail,
           ids,
           read_ids,
           table,
           positions,
           starts,
           nullptr,
           batch,
           table_width,
           ring_size,
           inherit != 0);
    return;
  }
  // A full wave of short rings already supplies 32 independent IPU jobs.
  // Read every original source in contiguous ring-sized transfers, then let
  // the unchanged chronological request kernel consume the immutable copy.
  if (distinct_sources && ring_size <= 64 &&
      (!parallel || (batch >= 32 && static_cast<int64_t>(tokens) <=
                                        static_cast<int64_t>(batch) * 64))) {
    snapshot_update_sources_kernel<<<grid,
                                     cnrtFuncTypeBlock,
                                     static_cast<cnrtQueue_t>(queue)>>>(
        static_cast<const bfloat16_t*>(tail),
        static_cast<const Id*>(ids),
        static_cast<const Id*>(read_ids),
        static_cast<bfloat16_t*>(workspace),
        batch,
        ring_size);
    const auto launch =
        cache_coefficients
            ? launch_chronological_update<Id, false, true, 64, true>
            : launch_chronological_update<Id, false, true, 64, false>;
    launch(queue,
           grid,
           cnrtFuncTypeBlock,
           key,
           gate,
           ape,
           matrix,
           cache,
           tail,
           ids,
           read_ids,
           table,
           positions,
           starts,
           workspace,
           batch,
           table_width,
           ring_size,
           /*inherit=*/true);
    return;
  }
  prepare_update_parallel_kernel<<<grid,
                                   cnrtFuncTypeBlock,
                                   static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const float*>(ape),
      static_cast<const float*>(matrix),
      static_cast<bfloat16_t*>(cache),
      static_cast<const bfloat16_t*>(tail),
      static_cast<const Id*>(ids),
      static_cast<const Id*>(read_ids),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      static_cast<bfloat16_t*>(workspace),
      batch,
      tokens,
      table_width,
      ring_size,
      inherit != 0);
  // Same-stream kernel ordering releases every original-tail reader before
  // destination stores, including cross-request source/destination cycles.
  scatter_update_tail_kernel<<<grid,
                               cnrtFuncTypeBlock,
                               static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(workspace),
      static_cast<bfloat16_t*>(tail),
      static_cast<const Id*>(ids),
      batch,
      ring_size);
}
}  // namespace

extern "C" void kpool_update_tokens_workspace(void* queue,
                                              const void* key,
                                              const void* gate,
                                              const void* ape,
                                              const void* matrix,
                                              void* cache,
                                              void* tail,
                                              const void* ids,
                                              const void* read_ids,
                                              const void* table,
                                              const void* positions,
                                              const void* starts,
                                              void* workspace,
                                              int32_t batch,
                                              int32_t table_width,
                                              int32_t ring_size,
                                              int32_t inherit,
                                              int32_t tokens) {
  update_with_workspace<int64_t>(queue,
                                 key,
                                 gate,
                                 ape,
                                 matrix,
                                 cache,
                                 tail,
                                 ids,
                                 read_ids,
                                 table,
                                 positions,
                                 starts,
                                 workspace,
                                 batch,
                                 table_width,
                                 ring_size,
                                 inherit,
                                 tokens);
}

