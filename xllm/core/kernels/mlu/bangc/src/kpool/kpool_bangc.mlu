namespace {
struct PositionWords {
  uint32_t low;
  int32_t high;
};

__mlu_func__ PositionWords load_position_words(const void* positions,
                                               int64_t index,
                                               bool wide) {
  const AliasInt32* words = static_cast<const AliasInt32*>(positions);
  int32_t low = words[index * (wide ? 2 : 1)];
  int32_t high = wide ? words[index * 2 + 1] : (low < 0 ? -1 : 0);
  return {static_cast<uint32_t>(low), high};
}

__mlu_func__ int32_t load_nonnegative_index(const void* values,
                                            int64_t index,
                                            bool wide) {
  PositionWords value = load_position_words(values, index, wide);
  return value.high == 0 && value.low <= INT32_MAX ? value.low : -1;
}

// The quotient is useful only when it fits a nonnegative int32 table column.
// divisor <= INT32_MAX makes every doubled remainder fit uint32 exactly.
__mlu_func__ int64_t load_nonnegative_offset(const void* values,
                                             int64_t index,
                                             bool wide) {
  PositionWords value = load_position_words(values, index, wide);
  if (value.high < 0) {
    return -1;
  }
  uint64_t high = static_cast<uint32_t>(value.high);
  return static_cast<int64_t>((high << 32) | value.low);
}

// Validate all original words before constructing an address-width scalar.
// A large positive high word must never wrap into a small live state slot.
__mlu_func__ int64_t load_bounded_offset(const void* values,
                                         int64_t index,
                                         bool wide,
                                         int64_t bound) {
  PositionWords value = load_position_words(values, index, wide);
  uint32_t bound_high = static_cast<uint64_t>(bound) >> 32;
  uint32_t bound_low = static_cast<uint32_t>(bound);
  if (bound <= 0 || value.high < 0 ||
      static_cast<uint32_t>(value.high) > bound_high ||
      (static_cast<uint32_t>(value.high) == bound_high &&
       value.low >= bound_low)) {
    return -1;
  }
  return load_nonnegative_offset(values, index, wide);
}

__mlu_func__ int32_t bounded_position_quotient(PositionWords position,
                                               uint32_t divisor) {
  if (position.high < 0 || static_cast<uint32_t>(position.high) >= divisor) {
    return -1;
  }
  uint32_t remainder = position.high;
  uint32_t quotient = 0;
  for (int32_t bit = 31; bit >= 0; --bit) {
    remainder = remainder * 2 + ((position.low >> bit) & 1);
    quotient <<= 1;
    if (remainder >= divisor) {
      remainder -= divisor;
      quotient |= 1;
    }
  }
  return quotient <= INT32_MAX ? quotient : -1;
}

}  // namespace

namespace {
__mlu_global__ void generic_tail_prepare_kernel(const bfloat16_t* key,
                                                const bfloat16_t* gate,
                                                const bfloat16_t* tail,
                                                const void* ids,
                                                const void* read_ids,
                                                const void* positions,
                                                const void* starts,
                                                bfloat16_t* workspace,
                                                int32_t batch,
                                                int32_t ring_size,
                                                int32_t dimension,
                                                int32_t flags,
                                                int64_t tail_states) {
  __nram__ bfloat16_t local_key[128], local_gate[128];
  // Bit 32 toggles the source width relative to the destination width.
  const bool source_wide = (flags & 1) != ((flags & 32) != 0);
  int32_t tiles = dimension / 128 + (dimension % 128 != 0);
  int64_t work_count = static_cast<int64_t>(batch) * ring_size * tiles;
  for (int64_t work = taskId; work < work_count; work += taskDim) {
    int64_t slot_job = work / tiles;
    int32_t request = slot_job / ring_size;
    int32_t ring = slot_job % ring_size;
    int64_t state = load_bounded_offset(ids, request, flags & 1, tail_states);
    if (state <= 0) {
      continue;
    }
    int32_t channel = (work % tiles) * 128;
    int32_t channels = dimension - channel < 128 ? dimension - channel : 128;
    int64_t begin = load_nonnegative_offset(starts, request, flags & 8);
    int64_t end = load_nonnegative_offset(starts, request + 1, flags & 8);
    int64_t source = end - 1;
    if (flags & 16) {
      while (source >= begin) {
        PositionWords position =
            load_position_words(positions, source, flags & 2);
        if (position.high >= 0 &&
            positive_position_mod(position.low,
                                  static_cast<uint32_t>(position.high),
                                  ring_size) == ring) {
          break;
        }
        --source;
      }
    } else {
      while (source >= begin &&
             load_position_words(positions, source, flags & 2).high < 0) {
        --source;
      }
      if (source >= begin) {
        PositionWords last = load_position_words(positions, source, flags & 2);
        uint32_t last_ring = positive_position_mod(
            last.low, static_cast<uint32_t>(last.high), ring_size);
        source -= (last_ring + ring_size - ring) % ring_size;
      }
    }
    bool current = source >= begin && source >= 0 &&
                   load_position_words(positions, source, flags & 2).high >= 0;
    if (current) {
      __memcpy_async(local_key,
                     key + source * dimension + channel,
                     channels * sizeof(bfloat16_t),
                     GDRAM2NRAM);
      __memcpy_async(local_gate,
                     gate + source * dimension + channel,
                     channels * sizeof(bfloat16_t),
                     GDRAM2NRAM);
    } else {
      int64_t old_state =
          load_bounded_offset(read_ids, request, source_wide, tail_states);
      if (old_state > 0) {
        const bfloat16_t* history =
            tail + static_cast<int64_t>(old_state) * 2 * ring_size * dimension;
        __memcpy_async(
            local_key,
            history + static_cast<int64_t>(ring) * dimension + channel,
            channels * sizeof(bfloat16_t),
            GDRAM2NRAM);
        __memcpy_async(
            local_gate,
            history + (static_cast<int64_t>(ring_size) + ring) * dimension +
                channel,
            channels * sizeof(bfloat16_t),
            GDRAM2NRAM);
      } else {
        __bang_write_value(local_key, channels, static_cast<bfloat16_t>(0));
        __bang_write_value(local_gate, channels, static_cast<bfloat16_t>(0));
      }
    }
    __sync();
    int64_t output =
        (static_cast<int64_t>(request) * 2 * ring_size + ring) * dimension +
        channel;
    __memcpy_async(workspace + output,
                   local_key,
                   channels * sizeof(bfloat16_t),
                   NRAM2GDRAM);
    __memcpy_async(
        workspace + output + static_cast<int64_t>(ring_size) * dimension,
        local_gate,
        channels * sizeof(bfloat16_t),
        NRAM2GDRAM);
    __sync_io();
  }
}

__mlu_global__ void generic_tail_scatter_kernel(const bfloat16_t* workspace,
                                                bfloat16_t* tail,
                                                const void* ids,
                                                int32_t batch,
                                                int32_t ring_size,
                                                int32_t dimension,
                                                bool wide_ids,
                                                int64_t tail_states) {
  __nram__ bfloat16_t chunk[128];
  int64_t elements = static_cast<int64_t>(ring_size) * 2 * dimension;
  int64_t chunks = elements / 128 + (elements % 128 != 0);
  int64_t work_count = static_cast<int64_t>(batch) * chunks;
  for (int64_t work = taskId; work < work_count; work += taskDim) {
    int32_t request = work / chunks;
    int64_t state = load_bounded_offset(ids, request, wide_ids, tail_states);
    if (state <= 0) {
      continue;
    }
    int64_t offset = work % chunks * 128;
    int32_t count = elements - offset < 128 ? elements - offset : 128;
    __memcpy(chunk,
             workspace + static_cast<int64_t>(request) * elements + offset,
             count * sizeof(bfloat16_t),
             GDRAM2NRAM);
    __memcpy(tail + static_cast<int64_t>(state) * elements + offset,
             chunk,
             count * sizeof(bfloat16_t),
             NRAM2GDRAM);
  }
}
}  // namespace

extern "C" void kpool_generic_tail_workspace_bounded(void* queue,
                                                     const void* key,
                                                     const void* gate,
                                                     void* tail,
                                                     const void* ids,
                                                     const void* read_ids,
                                                     const void* positions,
                                                     const void* starts,
                                                     void* workspace,
                                                     int32_t batch,
                                                     int32_t ring_size,
                                                     int32_t dimension,
                                                     int32_t flags,
                                                     int64_t tail_states) {
  cnrtDim3_t grid = {32, 1, 1};
  cnrtQueue_t stream = static_cast<cnrtQueue_t>(queue);
  generic_tail_prepare_kernel<<<grid, cnrtFuncTypeBlock, stream>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const bfloat16_t*>(tail),
      ids,
      read_ids,
      positions,
      starts,
      static_cast<bfloat16_t*>(workspace),
      batch,
      ring_size,
      dimension,
      flags,
      tail_states);
  // This same-stream boundary releases every reader of the original tail.
  generic_tail_scatter_kernel<<<grid, cnrtFuncTypeBlock, stream>>>(
      static_cast<const bfloat16_t*>(workspace),
      static_cast<bfloat16_t*>(tail),
      ids,
      batch,
      ring_size,
      dimension,
      (flags & 1) != 0,
      tail_states);
}

// Legacy raw ABI has no allocation extent. Keep address-width values from
// wrapping, while the public host always supplies the actual state count.
extern "C" void kpool_generic_tail_workspace(void* queue,
                                             const void* key,
                                             const void* gate,
                                             void* tail,
                                             const void* ids,
                                             const void* read_ids,
                                             const void* positions,
                                             const void* starts,
                                             void* workspace,
                                             int32_t batch,
                                             int32_t ring_size,
                                             int32_t dimension,
                                             int32_t flags) {
  kpool_generic_tail_workspace_bounded(queue,
                                       key,
                                       gate,
                                       tail,
                                       ids,
                                       read_ids,
                                       positions,
                                       starts,
                                       workspace,
                                       batch,
                                       ring_size,
                                       dimension,
                                       flags,
                                       (static_cast<int64_t>(1) << 47) - 1);
}
