extern "C" void kpool_stash_workspace(void* queue,
                                      const void* key,
                                      const void* gate,
                                      void* tail,
                                      const void* ids,
                                      const void* read_ids,
                                      const void* positions,
                                      const void* starts,
                                      void* workspace,
                                      int32_t batch,
                                      int32_t ring_size,
                                      int32_t bits) {
  if (bits == 32) {
    stash_with_workspace<int32_t>(queue,
                                  key,
                                  gate,
                                  tail,
                                  ids,
                                  read_ids,
                                  positions,
                                  starts,
                                  workspace,
                                  batch,
                                  ring_size,
                                  bits);
  } else {
    stash_with_workspace<int64_t>(queue,
                                  key,
                                  gate,
                                  tail,
                                  ids,
                                  read_ids,
                                  positions,
                                  starts,
                                  workspace,
                                  batch,
                                  ring_size,
                                  bits);
  }
}

extern "C" void kpool_prefill_workspace(void* queue,
                                        const void* key,
                                        const void* gate,
                                        const void* ape,
                                        const void* matrix,
                                        void* cache,
                                        void* tail,
                                        const void* ids,
                                        const void* read_ids,
                                        const void* table,
                                        const void* positions,
                                        const void* starts,
                                        const void* rows,
                                        void* workspace,
                                        int32_t batch,
                                        int32_t tokens,
                                        int32_t table_width,
                                        int32_t ring_size,
                                        int32_t inherit) {
  cnrtDim3_t grid = {32, 1, 1};
  prefill_kernel<<<grid, cnrtFuncTypeBlock, static_cast<cnrtQueue_t>(queue)>>>(
      static_cast<const bfloat16_t*>(key),
      static_cast<const bfloat16_t*>(gate),
      static_cast<const float*>(ape),
      static_cast<const float*>(matrix),
      static_cast<bfloat16_t*>(cache),
      static_cast<const bfloat16_t*>(tail),
      static_cast<const int64_t*>(read_ids),
      static_cast<const int32_t*>(table),
      static_cast<const int32_t*>(positions),
      static_cast<const int64_t*>(starts),
      static_cast<const int64_t*>(rows),
      tokens,
      table_width,
      ring_size,
      batch,
      static_cast<const int64_t*>(ids));
  // Pool reads complete before immutable stash preparation; stash itself closes
  // every source read globally before any destination tail write.
  stash_with_workspace<int64_t>(queue,
                                key,
                                gate,
                                tail,
                                ids,
                                inherit != 0 ? read_ids : ids,
                                positions,
                                starts,
                                workspace,
                                batch,
                                ring_size,
                                64);
}

